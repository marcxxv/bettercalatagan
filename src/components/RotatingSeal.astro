---
/**
 * The municipal seal as a struck medallion (lib/seal3d.ts).
 *
 * A real cylinder — gold body, bevelled bezel, milled edge, the same seal on
 * both faces so the lettering reads either way — turning slowly, one turn
 * every 24 seconds, beside the history section, with no controls. It can be
 * dragged or double-clicked to turn it over. The figure is server-rendered as a still image and upgraded in
 * place when three.js loads, so it is complete without JavaScript, without
 * WebGL, and in reduced motion (where it does not turn at all). The seal is a
 * stylised rendition, not an official identity asset, and the caption says so.
 */
---

<figure class="seal">
  <div
    class="seal-stage"
    data-seal
    role="img"
    aria-label="Stylised three-dimensional rendition of the Calatagan municipal seal, struck as a medal and turning slowly. Drag to turn it; the seal is printed the same on both sides."
  >
    <img class="seal-still" data-seal-still src="/images/calatagan-seal-face.webp" width="640" height="640" alt="" loading="lazy" decoding="async" />
  </div>
  <figcaption>Calatagan municipal seal<br /><span>Stylised rendition · independent civic project</span></figcaption>
</figure>

<script>
  import '../scripts/seal';
</script>

<style>
  .seal {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    text-align: center;
  }
  .seal-stage {
    --seal-size: clamp(10rem, 20vw, 14rem);
    width: var(--seal-size);
    aspect-ratio: 1;
    position: relative;
    order: -1;
    touch-action: pan-y;
  }
  .seal-stage[data-ready] {
    cursor: grab;
  }
  .seal-stage.is-dragging {
    cursor: grabbing;
  }
  .seal-still,
  .seal-stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .seal-still {
    object-fit: contain;
  }
  .seal-still[hidden] {
    display: none;
  }
  figcaption {
    color: var(--c-ink-2);
    font-size: var(--fs-xs);
    line-height: 1.5;
  }
  figcaption span {
    color: var(--c-muted);
  }
</style>
