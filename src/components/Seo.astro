---
/**
 * Page metadata: title, description, canonical URL, social previews and
 * structured data.
 *
 * The canonical origin comes from `Astro.site`, which astro.config.mjs derives
 * from the deployment environment, so previews never canonicalise to a
 * throwaway URL and no domain is assumed.
 */
import { SITE } from '../lib/site';

export interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  /** Breadcrumb trail, excluding the home page. Omit on the home page. */
  crumbs?: Crumb[];
  /** Additional JSON-LD objects, e.g. Dataset or Article. */
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, description, crumbs, jsonLd = [], ogType = 'website', noindex = false } = Astro.props;

const origin = Astro.site ?? new URL('http://localhost:4321');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, origin).toString();
const isHome = path === '/';
const fullTitle = isHome ? `${SITE.name} — ${SITE.shortDescription}` : `${title} — ${SITE.name}`;
// One share image per section (rendered by scripts/brand.mjs); the home image
// stands in for everything else.
const OG_PAGES = new Set(['history', 'government', 'finances', 'transparency', 'documents', 'sources', 'about', 'data']);
const section = path.split('/')[1] ?? '';
const ogImage = new URL(OG_PAGES.has(section) ? `/og/${section}.png` : '/og.png', origin).toString();

const structured: Record<string, unknown>[] = [];

/** The publisher, referenced by id from every page. */
const publisherId = new URL('/#publisher', origin).toString();
const websiteId = new URL('/#website', origin).toString();
const publisher = {
  '@type': 'Organization',
  '@id': publisherId,
  name: SITE.name,
  url: new URL('/about', origin).toString(),
  logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', origin).toString(), width: 512, height: 512 },
  description: SITE.independence,
  sameAs: [SITE.repository],
};

// Every page says what it is and what site it belongs to, so search engines
// can attribute it to the publisher above rather than guessing.
structured.push({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#page`,
  url: canonical,
  name: isHome ? SITE.name : title,
  description,
  inLanguage: 'en-PH',
  isPartOf: { '@id': websiteId },
  publisher: { '@id': publisherId },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
});

if (isHome) {
  structured.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: SITE.name,
    url: new URL('/', origin).toString(),
    description: SITE.description,
    inLanguage: 'en-PH',
    about: {
      '@type': 'AdministrativeArea',
      name: 'Calatagan, Batangas',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Batangas, Philippines' },
    },
    publisher: publisher,
  });
}

if (crumbs && crumbs.length > 0) {
  const trail = [{ name: 'Overview', href: '/' }, ...crumbs];
  structured.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.href, origin).toString(),
    })),
  });
}

structured.push(...jsonLd);

// `<` is escaped so no string inside the data can close the script element.
const serialise = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
{!noindex && <link rel="canonical" href={canonical} />}
<link rel="alternate" type="application/json" title="Open data catalogue" href="/data/index.json" />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={isHome ? SITE.name : title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content={`Better Calatagan — ${isHome ? 'an independent civic guide to Calatagan, Batangas' : title}`}
/>
<meta name="twitter:image:alt" content={`Better Calatagan — ${isHome ? 'an independent civic guide to Calatagan, Batangas' : title}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={isHome ? SITE.name : title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{structured.map((data) => <script type="application/ld+json" set:html={serialise(data)} />)}
