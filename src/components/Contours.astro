---
/**
 * The ambient background for dark bands: depth contours drifting like swell
 * on a nautical chart, and — optionally — the slow sweep of a lighthouse beam,
 * for the Cape Santiago light.
 *
 * Pure SVG and CSS, generated at build time; decorative and hidden from
 * assistive technology. Motion stops entirely under prefers-reduced-motion.
 */
interface Props {
  lines?: number;
  beam?: boolean;
  /** Vertical position of the densest band, 0–1. */
  focus?: number;
}
const { lines = 14, beam = false, focus = 0.62 } = Astro.props;

const W = 1200;
const H = 600;
const TAU = Math.PI * 2;

// Deterministic pseudo-random numbers, so every build draws the same chart.
let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};

/** One contour line spanning two periods (2W), so it can loop seamlessly. */
function contour(i: number) {
  const t = i / (lines - 1);
  const spread = Math.pow(Math.abs(t - 0.5) * 2, 1.4);
  const base = H * focus + (t - 0.5) * H * 1.15 + (t - 0.5) * spread * 60;
  const a1 = 14 + rand() * 26;
  const a2 = 6 + rand() * 12;
  const k1 = 1 + Math.floor(rand() * 2);
  const k2 = 3 + Math.floor(rand() * 3);
  const p1 = rand() * TAU;
  const p2 = rand() * TAU;
  const points: string[] = [];
  for (let x = 0; x <= W * 2; x += 20) {
    const y = base + a1 * Math.sin((x / W) * TAU * k1 + p1) + a2 * Math.sin((x / W) * TAU * k2 + p2);
    points.push(`${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)}`);
  }
  return points.join('');
}

const paths = Array.from({ length: lines }, (_, i) => ({
  d: contour(i),
  major: i % 4 === 0,
  layer: i % 3,
}));
---

<div class="contours" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <linearGradient id="contour-fade" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="white" stop-opacity="0.15" />
        <stop offset="0.45" stop-color="white" stop-opacity="1" />
        <stop offset="1" stop-color="white" stop-opacity="0.35" />
      </linearGradient>
      <mask id="contour-mask">
        <rect width={W} height={H} fill="url(#contour-fade)" />
      </mask>
    </defs>
    <g mask="url(#contour-mask)">
      {[0, 1, 2].map((layer) => (
        <g class={`drift drift-${layer}`}>
          {paths
            .filter((p) => p.layer === layer)
            .map((p) => (
              <path d={p.d} class:list={['line', { major: p.major }]} />
            ))}
        </g>
      ))}
    </g>
  </svg>
  {beam && <div class="beam"></div>}
  <div class="glow"></div>
</div>

<style>
  .contours {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .line {
    fill: none;
    stroke: var(--contour);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .line.major {
    stroke: var(--contour-major);
    stroke-width: 1.4;
  }
  .drift {
    animation: drift linear infinite;
  }
  .drift-0 {
    animation-duration: 90s;
  }
  .drift-1 {
    animation-duration: 130s;
    animation-direction: reverse;
  }
  .drift-2 {
    animation-duration: 170s;
  }
  @keyframes drift {
    to {
      transform: translateX(-1200px);
    }
  }

  /* A lighthouse beam, sweeping slowly from beyond the top-right corner. */
  .beam {
    position: absolute;
    top: -40%;
    right: -20%;
    width: 140%;
    aspect-ratio: 1;
    background: conic-gradient(
      from 200deg at 70% 30%,
      transparent 0deg,
      var(--beam) 8deg,
      transparent 18deg,
      transparent 26deg
    );
    transform-origin: 70% 30%;
    animation: sweep 16s var(--ease-in-out) infinite alternate;
  }
  @keyframes sweep {
    from {
      transform: rotate(-14deg);
    }
    to {
      transform: rotate(22deg);
    }
  }
  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 50% 0%, var(--c-panel-2), transparent 70%),
      radial-gradient(40% 50% at 100% 100%, color-mix(in srgb, var(--c-accent) 6%, transparent), transparent 70%);
  }
  @media (prefers-reduced-motion: reduce) {
    .drift,
    .beam {
      animation: none;
    }
  }
</style>
