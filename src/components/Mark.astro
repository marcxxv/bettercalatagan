---
/**
 * The Better Calatagan emblem mark: the Cape Santiago lighthouse on the cape,
 * before the Philippine sun, drawn in the BetterGov.ph family style. The
 * vector source is public/logo-mark.svg (full lockup: public/logo.svg); the
 * raster icons and share images are rendered from it by scripts/brand.mjs.
 */
import raw from '../../public/logo-mark.svg?raw';

interface Props {
  size?: number;
  title?: string;
}
const { size = 32, title } = Astro.props;
const svg = raw
  .replaceAll('#1a3aa8', 'var(--logo-ink)')
  .replaceAll('#ffffff', 'var(--logo-bg)')
  .replace('<svg ', `<svg class="mark" width="${size}" height="${size}" focusable="false" ${title ? `role="img" aria-label="${title}"` : 'aria-hidden="true"'} `)
  .trim();
---

<Fragment set:html={svg} />
