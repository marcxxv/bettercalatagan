---
/**
 * The Better Calatagan mark: a lighthouse over water, for Cape Santiago.
 *
 * Deliberately a rounded square rather than a circle, and without any shield,
 * sun, star or wreath, so that it cannot be mistaken for a seal or for any
 * government insignia.
 */
interface Props {
  size?: number;
  title?: string;
}
const { size = 32, title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <rect width="32" height="32" rx="7" fill="#12304a" />
  <path d="M13.2 9.5h5.6l1.4 12.5h-8.4z" fill="#f6f2e9" />
  <rect x="12.6" y="7" width="6.8" height="2.6" rx="0.8" fill="#e39a78" />
  <path d="M19.8 8.2 27 5.6v5.2z" fill="#8fdad0" opacity="0.9" />
  <path
    d="M3 24.6c2.2 0 2.2-1.6 4.4-1.6s2.2 1.6 4.4 1.6 2.2-1.6 4.4-1.6 2.2 1.6 4.4 1.6 2.2-1.6 4.4-1.6 2.2 1.6 3.9 1.6"
    fill="none"
    stroke="#5fc4b8"
    stroke-width="1.8"
    stroke-linecap="round"
  />
  <path
    d="M5.6 28.2c1.8 0 1.8-1.2 3.6-1.2s1.8 1.2 3.6 1.2 1.8-1.2 3.6-1.2 1.8 1.2 3.6 1.2 1.8-1.2 3.6-1.2 1.8 1.2 3.2 1.2"
    fill="none"
    stroke="#5fc4b8"
    stroke-width="1.4"
    stroke-linecap="round"
    opacity="0.6"
  />
</svg>
