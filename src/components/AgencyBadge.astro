---
/**
 * A round badge for a source agency.
 *
 * If the agency's own logo file has been added to public/agencies/ (for
 * example public/agencies/psa.png), it is shown; otherwise the badge shows the
 * agency's initials. Logos are added by maintainers from each agency's official
 * source — never redrawn here — and appear only to credit where data comes from.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';

export const AGENCIES = {
  psa: { initials: 'PSA', name: 'Philippine Statistics Authority' },
  dilg: { initials: 'DILG', name: 'Department of the Interior and Local Government' },
  blgf: { initials: 'BLGF', name: 'Bureau of Local Government Finance' },
  dof: { initials: 'DOF', name: 'Department of Finance' },
  nhcp: { initials: 'NHCP', name: 'National Historical Commission of the Philippines' },
  ia: { initials: 'IA', name: 'Internet Archive' },
} as const;
export type AgencyKey = keyof typeof AGENCIES;

/** The agency behind a publisher string, if it is one we badge. */
export function agencyOf(publisher: string): AgencyKey | null {
  if (/Statistics Authority/i.test(publisher)) return 'psa';
  if (/Local Government Finance/i.test(publisher)) return 'blgf';
  if (/Interior and Local Government|DILG/i.test(publisher)) return 'dilg';
  if (/Department of Finance/i.test(publisher)) return 'dof';
  if (/Historical Commission/i.test(publisher)) return 'nhcp';
  if (/Internet Archive/i.test(publisher)) return 'ia';
  return null;
}

interface Props {
  agency: AgencyKey;
  size?: string;
  class?: string;
}
const { agency, size = '2.25rem', class: className } = Astro.props;
const info = AGENCIES[agency];
const file = ['svg', 'png', 'webp'].map((ext) => `${agency}.${ext}`).find((f) => existsSync(join(process.cwd(), 'public', 'agencies', f)));
---

<span class:list={['agency', className, { 'has-logo': file }]} style={`--size:${size}`} title={info.name}>
  {file ? <img src={`/agencies/${file}`} alt={info.name} width="64" height="64" loading="lazy" decoding="async" /> : <span class="ini" aria-hidden="true">{info.initials}</span>}
  {!file && <span class="visually-hidden">{info.name}</span>}
</span>

<style>
  .agency {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #ffffff, #eef1f8);
    box-shadow: 0 0 0 1.5px #d79f22, 0 2px 8px rgb(11 18 32 / 0.18);
    color: #1b3c8c;
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: -0.02em;
    overflow: hidden;
    vertical-align: middle;
  }
  .ini {
    font-size: calc(var(--size) * 0.3);
    line-height: 1;
  }
  .agency.has-logo {
    background: #fff;
    box-shadow: 0 0 0 1px rgb(11 18 32 / 0.12), 0 2px 8px rgb(11 18 32 / 0.18);
  }
  .agency img {
    width: 88%;
    height: 88%;
    object-fit: contain;
  }
</style>
