---
/**
 * A column chart (single or grouped series), drawn as static SVG at build time.
 *
 * The SVG is decorative to assistive technology: every chart on this site sits
 * beside a table or text that states the same numbers. Columns grow into view
 * and show exact values on hover or focus.
 */
interface Series {
  name: string;
  /** A CSS colour, usually a token such as var(--c-s1). */
  color: string;
  values: (number | null)[];
}

interface Props {
  categories: string[];
  series: Series[];
  /** Formats axis ticks and labels. */
  format?: 'number' | 'peso-m';
  height?: number;
  /** Print the value above each column. */
  labels?: boolean;
  caption?: string;
  /** Extra tooltip line per category. */
  notes?: string[];
}

const { categories, series, format = 'number', height = 280, labels = false, caption, notes = [] } = Astro.props;

const W = 720;
const H = height;
const pad = { top: labels ? 30 : 16, right: 8, bottom: 34, left: 58 };
const innerW = W - pad.left - pad.right;
const innerH = H - pad.top - pad.bottom;

const all = series.flatMap((s) => s.values.filter((v): v is number => v !== null));
const rawMax = Math.max(1, ...all);

/** A "nice" axis maximum and step. */
function nice(max: number) {
  const exp = Math.floor(Math.log10(max));
  const base = Math.pow(10, exp);
  for (const m of [1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10]) {
    if (m * base >= max) {
      const top = m * base;
      const steps = [4, 5, 6, 3].find((n) => Number.isInteger(((top / n) / base) * 100)) ?? 4;
      return { top, step: top / steps };
    }
  }
  return { top: max, step: max / 4 };
}
const { top, step } = nice(rawMax * 1.02);
const ticks: number[] = [];
for (let v = 0; v <= top + step / 2; v += step) ticks.push(v);

const y = (v: number) => pad.top + innerH - (v / top) * innerH;
const band = innerW / categories.length;
const groupW = band * (series.length > 1 ? 0.72 : 0.56);
const barW = groupW / series.length;

const int = new Intl.NumberFormat('en-PH');
const fmtTick = (v: number) => {
  if (format === 'peso-m') return `₱${int.format(Math.round(v / 1e6))}M`;
  if (v >= 1000) return `${int.format(v / 1000)}k`;
  return int.format(v);
};
const fmtFull = (v: number) =>
  format === 'peso-m'
    ? `₱${(v / 1e6).toLocaleString('en-PH', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}M`
    : int.format(v);
---

<figure class="chart column-chart" data-animate>
  {caption && <figcaption>{caption}</figcaption>}
  <svg viewBox={`0 0 ${W} ${H}`} role="presentation" aria-hidden="true" focusable="false">
    <g class="axis">
      {ticks.map((t) => (
        <g>
          <line class="grid-line" x1={pad.left} x2={W - pad.right} y1={y(t)} y2={y(t)} />
          <text x={pad.left - 10} y={y(t)} text-anchor="end" dominant-baseline="middle">{fmtTick(t)}</text>
        </g>
      ))}
      <line class="baseline" x1={pad.left} x2={W - pad.right} y1={y(0)} y2={y(0)} />
    </g>
    {categories.map((cat, ci) => {
      const gx = pad.left + band * ci + (band - groupW) / 2;
      return (
        <g class="col-group">
          <rect
            class="hit"
            x={pad.left + band * ci}
            y={pad.top}
            width={band}
            height={innerH}
            data-tip={[cat, ...series.map((s) => `${s.name}: ${s.values[ci] === null ? '—' : fmtFull(s.values[ci]!)}`), ...(notes[ci] ? [notes[ci]] : [])].join('|')}
          />
          {series.map((s, si) => {
            const v = s.values[ci];
            if (v === null) return null;
            const bx = gx + barW * si + (series.length > 1 ? 2 : 0);
            const bw = barW - (series.length > 1 ? 4 : 0);
            return (
              <>
                <rect
                  class="col"
                  x={bx}
                  y={y(v)}
                  width={bw}
                  height={Math.max(0, y(0) - y(v))}
                  rx="3"
                  fill={s.color}
                  data-grow-y
                  style={`--reveal-delay:${ci * 90 + si * 40}ms`}
                />
                {labels && (
                  <text class="val" x={bx + bw / 2} y={y(v) - 8} text-anchor="middle">{fmtFull(v)}</text>
                )}
              </>
            );
          })}
          <text class="cat" x={pad.left + band * ci + band / 2} y={H - 10} text-anchor="middle">{cat}</text>
        </g>
      );
    })}
  </svg>
  {series.length > 1 && (
    <ul class="chart-legend">
      {series.map((s) => (
        <li><span class="swatch" style={`background:${s.color}`}></span>{s.name}</li>
      ))}
    </ul>
  )}
</figure>

<style>
  .hit {
    fill: transparent;
  }
  .col-group:hover .hit {
    fill: var(--c-bg-alt);
  }
  :global([data-theme='dark']) .col-group:hover .hit {
    fill: rgb(255 255 255 / 0.03);
  }
  .col {
    pointer-events: none;
  }
  .cat {
    font-weight: 700;
    fill: var(--c-ink-2) !important;
    font-size: 13px !important;
  }
  .val {
    font-weight: 800;
    fill: var(--c-navy) !important;
    font-size: 13px !important;
    font-variant-numeric: tabular-nums;
  }
</style>
