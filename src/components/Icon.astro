---
/**
 * A small set of stroke icons, drawn on a 24px grid so they sit with text.
 *
 * Decorative by default (aria-hidden). Pass `label` only when the icon stands
 * alone and carries meaning.
 */
export type IconName =
  | 'search'
  | 'people'
  | 'pin'
  | 'landmark'
  | 'coins'
  | 'file'
  | 'archive'
  | 'book'
  | 'shield'
  | 'database'
  | 'info'
  | 'arrow-right'
  | 'external'
  | 'sun'
  | 'moon'
  | 'monitor'
  | 'menu'
  | 'close'
  | 'check'
  | 'alert'
  | 'clock'
  | 'download'
  | 'chevron-down'
  | 'code'
  | 'calendar'
  | 'home'
  | 'chart'
  | 'layers'
  | 'lighthouse'
  | 'flag'
  | 'eye-off'
  | 'copy'
  | 'sort';

interface Props {
  name: IconName;
  size?: number | string;
  label?: string;
  class?: string;
}

const { name, size = '1.25em', label, class: className } = Astro.props;

const PATHS: Record<IconName, string> = {
