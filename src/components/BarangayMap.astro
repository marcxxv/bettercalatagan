---
/**
 * The barangay map: 25 outlines, raised in 3D by population, households or
 * DPWH projects, over the terrain and the coastline.
 *
 * The page first renders a plain SVG map (every barangay a link, shaded by
 * population), so it works without JavaScript and before anything loads. When
 * the map scrolls into view, scripts/barangay-map.ts loads MapLibre, fetches
 * the basemap and terrain tiles, and takes over. Colours come from the site's
 * tokens, so the map follows the light and dark themes.
 */
import Icon from './Icon.astro';
import { boundaries } from '../data/boundaries';
import { barangayPages } from '../lib/barangay-pages';
import { projectToSvg } from '../lib/geo';
import { formatNumber } from '../lib/format';
import { KIND_ICONS } from '../lib/project-kind';

interface Props {
  /** A barangay's PSGC code: the map opens on it, selected, and the outline map marks it. */
  focus?: string;
  /**
   * "works" raises barangays by DPWH projects (all, by budget, or one kind of
   * work) instead of by census counts — the infrastructure page's map.
   */
  mode?: 'people' | 'works';
}
const { focus, mode = 'people' } = Astro.props;
const works = mode === 'works';
const KIND_METRICS = [
  ['k_flood', 'Flood control'],
  ['k_road', 'Roads'],
  ['k_bridge', 'Bridges'],
  ['k_water', 'Water'],
  ['k_building', 'Buildings'],
] as const;
const byCode = new Map(barangayPages.map((b) => [b.psgc10, b]));
const svg = projectToSvg(boundaries.features);
const valueOf = (b: (typeof barangayPages)[number]) => (works ? b.projects.length : (b.census?.totalPopulation ?? 0));
const max = Math.max(1, ...barangayPages.map(valueOf));
---

<section class:list={['bmap', { focused: focus, works }]} data-bgy-map data-src="/data/barangays.geojson" data-focus={focus} data-mode={mode} data-metric={works ? 'projects' : undefined} aria-labelledby="bmap-title">
  <h2 id="bmap-title" class="visually-hidden">{focus ? `${byCode.get(focus)?.name} on the map of Calatagan` : works ? 'Map of DPWH projects by barangay' : 'Map of Calatagan’s barangays'}</h2>

  <div class="bmap-stage">
    <svg class="bmap-fallback" viewBox={`0 0 ${svg.width} ${svg.height}`} role="group" aria-labelledby="bmap-svg-title">
      <title id="bmap-svg-title">{works ? 'Calatagan’s 25 barangays, shaded by DPWH projects named in each' : 'Calatagan’s 25 barangays, shaded by 2024 population'}</title>
      {svg.paths.map((p) => {
        const b = byCode.get(p.psgc10)!;
        const t = valueOf(b) / max;
        return (
          <a href={works ? `/infrastructure?barangay=${b.slug}#projects` : `/barangays/${b.slug}`} data-psgc={b.psgc10} class:list={{ on: b.psgc10 === focus }} aria-current={b.psgc10 === focus ? 'page' : undefined}>
            <title>{b.name}: {works ? `${b.projects.length} DPWH ${b.projects.length === 1 ? 'project' : 'projects'}` : `${formatNumber(b.census?.totalPopulation ?? 0)} people`}</title>
            <path d={p.d} style={`--t:${(0.12 + t * 0.78).toFixed(2)}`} />
          </a>
        );
      })}
      {svg.paths.map((p) => (
        <text x={p.label[0]} y={p.label[1]} aria-hidden="true">{byCode.get(p.psgc10)!.name.replace(' (Pob.)', '')}</text>
      ))}
    </svg>
    <div class="bmap-canvas" data-map-canvas aria-hidden="true" inert></div>

    <div class="bmap-bar bmap-top" data-map-ui hidden>
      {works ? (
        <div class="seg seg-works" role="radiogroup" aria-label="Raise barangays by">
          <button type="button" role="radio" aria-checked="true" data-metric="projects">All projects</button>
          <button type="button" role="radio" aria-checked="false" data-metric="budget">Budgets</button>
          {KIND_METRICS.map(([m, label]) => (
            <button type="button" role="radio" aria-checked="false" data-metric={m}>{label}</button>
          ))}
        </div>
      ) : (
        <div class="seg" role="radiogroup" aria-label="Raise barangays by">
          <button type="button" role="radio" aria-checked="true" data-metric="population">Population</button>
          <button type="button" role="radio" aria-checked="false" data-metric="households">Households</button>
          <button type="button" role="radio" aria-checked="false" data-metric="projects">DPWH projects</button>
        </div>
      )}
      <div class="bmap-tools">
        <button type="button" class="tool" data-map-3d aria-pressed="true" data-tip="Flat or 3D view">3D</button>
        <button type="button" class="tool" data-map-zoom="1" aria-label="Zoom in"><Icon name="plus" size="16" /></button>
        <button type="button" class="tool" data-map-zoom="-1" aria-label="Zoom out"><span aria-hidden="true" class="minus"></span></button>
        <button type="button" class="tool" data-map-reset aria-label="Reset the view"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg></button>
      </div>
    </div>

    <div class="bmap-legend" data-map-ui hidden>
      <span data-legend-label>{works ? 'DPWH projects named' : 'Population, 2024'}</span>
      <span class="ramp" aria-hidden="true"></span>
      <span class="ends"><span data-legend-min>0</span><span data-legend-max>{formatNumber(max)}</span></span>
    </div>

    <div class="bmap-tip" data-map-tip hidden></div>

    <aside class="bmap-card" data-map-card hidden aria-live="polite"></aside>
    {Object.entries(KIND_ICONS).map(([kind, name]) => (
      <template data-kind-icon={kind}><Icon name={name} size="15" /></template>
    ))}

    <p class="bmap-status" data-map-status hidden></p>
  </div>
</section>

<script>
  import '../scripts/barangay-map';
</script>

<style>
  .bmap {
    margin-block: 0 var(--sp-8);
  }
  .bmap-stage {
    position: relative;
    isolation: isolate;
    height: clamp(26rem, 62vh, 40rem);
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-xl, 24px);
    background: var(--c-bg-alt);
  }
  .bmap-fallback {
    position: absolute;
    inset: var(--sp-6);
    width: calc(100% - 2 * var(--sp-6));
    height: calc(100% - 2 * var(--sp-6));
    transition: opacity 500ms var(--ease-out);
  }
  .bmap-fallback path {
    fill: color-mix(in srgb, var(--c-accent) calc(var(--t) * 100%), var(--c-surface));
    stroke: var(--c-surface);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    transition: fill var(--dur-1);
  }
  .focused .bmap-fallback a:not(.on) path {
    fill: color-mix(in srgb, var(--c-accent) 14%, var(--c-surface));
  }
  .bmap-fallback a.on path {
    fill: var(--c-clay);
  }
  .focused {
    margin-bottom: var(--sp-3);
  }
  .focused .bmap-legend {
    display: none;
  }
  .focused .bmap-stage {
    height: clamp(22rem, 48vh, 30rem);
  }
  .bmap-fallback a:hover path,
  .bmap-fallback a:focus-visible path {
    fill: var(--c-clay, var(--c-accent-strong));
  }
  .bmap-fallback a:focus-visible {
    outline: none;
  }
  .bmap-fallback text {
    font: 600 11px var(--font-sans);
    fill: var(--c-ink);
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--c-surface);
    stroke-width: 3px;
    pointer-events: none;
  }
  .bmap-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }
  .bmap.ready .bmap-canvas {
    opacity: 1;
  }
  .bmap.ready .bmap-fallback {
    opacity: 0;
    pointer-events: none;
  }

  .bmap-bar {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    justify-content: space-between;
    pointer-events: none;
  }
  .bmap-top {
    inset: var(--sp-4) var(--sp-4) auto;
  }
  .bmap [hidden] {
    display: none !important;
  }
  .bmap-bar > * {
    pointer-events: auto;
  }
  .seg,
  .bmap-tools,
  .bmap-legend,
  .bmap-card,
  .bmap-tip {
    border: 1px solid var(--c-line);
    background: color-mix(in srgb, var(--c-surface) 92%, transparent);
    box-shadow: var(--shadow-sm);
    backdrop-filter: saturate(1.4) blur(10px);
  }
  .seg {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
  }
  .seg button {
    min-height: 34px;
    padding: 0 var(--sp-3);
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--c-muted);
    font: 600 var(--fs-xs) var(--font-sans);
    cursor: pointer;
    transition: background var(--dur-1), color var(--dur-1);
  }
  /* Seven measures: scroll sideways rather than wrap over the map. */
  .seg-works {
    max-width: calc(100% - 11rem);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .seg-works::-webkit-scrollbar {
    display: none;
  }
  .seg-works button {
    flex: none;
  }
  .seg button[aria-checked='true'] {
    background: var(--c-accent);
    color: var(--c-surface);
  }
  .seg button:not([aria-checked='true']):hover {
    color: var(--c-ink);
  }
  .bmap-tools {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
  }
  .tool {
    display: grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    padding: 0 var(--sp-2);
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--c-ink);
    font: 700 var(--fs-xs) var(--font-sans);
    cursor: pointer;
  }
  .tool:hover {
    background: var(--c-sunk);
  }
  .tool[aria-pressed='true'] {
    color: var(--c-accent);
  }
  .minus {
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .bmap-legend {
    position: absolute;
    z-index: 2;
    left: var(--sp-4);
    bottom: var(--sp-4);
    display: grid;
    gap: 6px;
    width: min(15rem, 45%);
    padding: var(--sp-3);
    border-radius: var(--radius-md);
    font-size: var(--fs-2xs);
    color: var(--c-muted);
  }
  .bmap-legend > span:first-child {
    font-weight: 700;
    color: var(--c-ink);
  }
  .ramp {
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c-accent) 12%, var(--c-surface)), var(--c-accent));
  }
  .ends {
    display: flex;
    justify-content: space-between;
    font-variant-numeric: tabular-nums;
  }

  .bmap-tip {
    position: absolute;
    z-index: 3;
    left: 0;
    top: 0;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius-md);
    font-size: var(--fs-xs);
    pointer-events: none;
    white-space: nowrap;
    transform: translate(var(--x, 0), var(--y, 0));
  }
  .bmap-tip :global(strong) {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink);
  }
  .bmap-tip :global(span) {
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }

  .bmap-card {
    position: absolute;
    z-index: 2;
    right: var(--sp-4);
    bottom: var(--sp-4);
    width: min(19rem, calc(100% - 2 * var(--sp-4)));
    padding: var(--sp-4);
    border-radius: var(--radius-lg);
    animation: card-in var(--dur-2) var(--ease-out);
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .bmap-card :global(.c-name) {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    color: var(--c-ink);
  }
  .bmap-card :global(dl) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-2);
    margin: var(--sp-3) 0;
  }
  .bmap-card :global(dt) {
    font-size: var(--fs-2xs);
    color: var(--c-muted);
  }
  .bmap-card :global(dd) {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .bmap-card :global(.c-close) {
    position: absolute;
    top: var(--sp-2);
    right: var(--sp-2);
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--c-muted);
    font-size: 18px;
    cursor: pointer;
  }
  .bmap-card :global(.c-close:hover) {
    background: var(--c-sunk);
    color: var(--c-ink);
  }


  .bmap-card {
    max-height: calc(100% - 2 * var(--sp-4) - 3rem);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .bmap-card :global(.c-kinds) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 var(--sp-3);
    padding: 0;
    list-style: none;
  }
  .bmap-card :global(.c-kinds a) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 9px 2px 5px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface);
    color: var(--c-ink-2);
    font-size: var(--fs-2xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: border-color var(--dur-1), background var(--dur-1);
  }
  .bmap-card :global(.c-kinds a:hover) {
    border-color: var(--c-accent-line, var(--c-line-strong));
    background: var(--c-wash-raised, var(--c-sunk));
    color: var(--c-ink);
  }
  .bmap-card :global(.c-kinds .icon),
  .bmap-card :global(.c-work .icon) {
    color: var(--c-accent);
  }
  .bmap-card :global(.c-works) {
    display: grid;
    gap: 2px;
    margin: 0 calc(-1 * var(--sp-2)) var(--sp-3);
    padding: 0;
    list-style: none;
  }
  .bmap-card :global(.c-work) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2px var(--sp-2);
    padding: var(--sp-2);
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-1), transform var(--dur-1) var(--ease-out);
    animation: work-in var(--dur-3) var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 45ms);
  }
  .bmap-card :global(.c-work:hover),
  .bmap-card :global(.c-work:focus-visible) {
    background: var(--c-wash-raised, var(--c-sunk));
    transform: translateX(2px);
  }
  .bmap-card :global(.c-work-icon) {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--c-wash-raised, var(--c-accent-wash));
    grid-row: span 2;
  }
  .bmap-card :global(.c-work-title) {
    color: var(--c-ink);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bmap-card :global(.c-work-meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px var(--sp-2);
    color: var(--c-muted);
    font-size: var(--fs-2xs);
    font-variant-numeric: tabular-nums;
  }
  .bmap-card :global(.c-bar) {
    flex: 1 0 3rem;
    max-width: 5rem;
    height: 4px;
    border-radius: 999px;
    background: var(--c-line);
    overflow: hidden;
  }
  .bmap-card :global(.c-bar > span) {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--c-ok);
    transform-origin: left;
    animation: bar-grow 700ms var(--ease-out) both;
    animation-delay: calc(150ms + var(--i, 0) * 45ms);
  }
  .bmap-card :global(.c-links) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    font-size: var(--fs-xs);
  }
  @keyframes work-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  @keyframes bar-grow {
    from {
      transform: scaleX(0);
    }
  }

  .bmap-card :global(.c-work.is-current) {
    background: var(--c-wash-raised, var(--c-accent-wash));
    box-shadow: inset 0 0 0 1px var(--c-accent-line, var(--c-accent));
  }
  /* DPWH-reported coordinates: a pin with its provenance in the label. */
  .bmap :global(.bmap-pin) {
    display: grid;
    justify-items: center;
    gap: 6px;
    animation: pin-drop 500ms var(--ease-out) both;
  }
  .bmap :global(.bmap-pin-head) {
    width: 22px;
    height: 22px;
    margin-bottom: 6px;
    border: 3px solid var(--c-surface);
    border-radius: 50% 50% 50% 0;
    background: var(--c-clay);
    box-shadow: var(--shadow-md);
    transform: rotate(-45deg);
  }
  .bmap :global(.bmap-pin-label) {
    padding: 3px 8px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface);
    color: var(--c-ink);
    font: 600 var(--fs-2xs) var(--font-sans);
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
  }
  @keyframes pin-drop {
    from {
      opacity: 0;
      translate: 0 -14px;
    }
  }

  .bmap-status {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: var(--sp-4);
    margin: 0;
    padding: var(--sp-2) var(--sp-3);
    border-radius: 999px;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    font-size: var(--fs-xs);
    color: var(--c-muted);
    transform: translateX(-50%);
  }

  .bmap :global(.maplibregl-ctrl-attrib) {
    font-size: 10px;
    background: color-mix(in srgb, var(--c-surface) 85%, transparent);
    color: var(--c-muted);
  }
  .bmap :global(.maplibregl-ctrl-attrib a) {
    color: var(--c-muted);
  }

  @media (max-width: 40rem) {
    .bmap-fallback text {
      display: none;
    }
    .bmap-stage {
      height: 30rem;
      border-radius: var(--radius-lg);
    }
    .bmap-legend {
      display: none;
    }
    .seg button {
      padding: 0 var(--sp-2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bmap-card,
    .bmap-card :global(.c-work),
    .bmap-card :global(.c-bar > span),
    .bmap :global(.bmap-pin) {
      animation: none;
    }
  }
</style>
