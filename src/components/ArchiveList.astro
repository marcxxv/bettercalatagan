---
/**
 * Documents from the former municipal website, as a compact dataset: one row
 * each, with its kind, year, capture date and size, and icon actions to read
 * it on the site or download it. Used wherever archived documents are grouped
 * by topic (legislation, procurement).
 */
import Icon from './Icon.astro';
import type { ArchivedDocument } from '../data/schemas/documents';
import { KIND_LABELS } from '../data/schemas/documents';
import { archiveReadAttrs, sizeLabel } from '../lib/viewer';

interface Props {
  documents: readonly ArchivedDocument[];
  /** id for the list, so a filter form can target it. */
  id?: string;
  showKind?: boolean;
}

const { documents, id, showKind = true } = Astro.props;
const cols = showKind
  ? 'minmax(0, 1fr) 11rem 4.5rem 7rem 5.5rem'
  : 'minmax(0, 1fr) 4.5rem 7.5rem 7rem 5.5rem';
---

<div class="dataset" style={`--cols: ${cols}`}>
  <div class="dataset-head" aria-hidden="true">
    <span>Document</span>
    {showKind && <span>Kind</span>}
    <span>Year</span>
    {showKind ? <span>File</span> : <><span>Archived</span><span>File</span></>}
    <span class="num">Open</span>
  </div>
  <ul class="dataset-rows" id={id}>
    {documents.map((doc) => {
      const read = archiveReadAttrs(doc);
      const file = `${doc.fileType.toUpperCase()}${doc.byteLength ? ` · ${sizeLabel(doc.byteLength)}` : ''}`;
      return (
        <li
          class="dataset-row"
          data-item
          data-year={String(doc.publishedYear ?? '')}
          data-kind={doc.kind}
          data-search={`${doc.title} ${doc.filename} ${doc.publishedYear ?? ''}`.toLowerCase()}
        >
          <div class="cell main">
            <p class="row-title">{doc.title}</p>
            {showKind && <p class="row-sub">Archived {doc.capturedAt}</p>}
          </div>
          {showKind && <span class="cell"><span class="cell-label">Kind</span>{KIND_LABELS[doc.kind]}</span>}
          <span class="cell"><span class="cell-label">Year</span>{doc.publishedYear ?? '—'}</span>
          {!showKind && <span class="cell muted"><span class="cell-label">Archived</span>{doc.capturedAt}</span>}
          <span class="cell muted"><span class="cell-label">File</span>{file}</span>
          <span class="cell row-actions">
            {read && (
              <a class="icon-action primary" href={doc.archiveUrl} rel="noopener noreferrer nofollow" title="Read on this site" {...read}>
                <Icon name="eye" size="17" /><span class="visually-hidden">Read {doc.title}</span>
              </a>
            )}
            <a class="icon-action" href={doc.archiveUrl} rel="noopener noreferrer nofollow" title="Open the archived original">
              <Icon name="external" size="16" /><span class="visually-hidden">Open the archived original of {doc.title}</span>
            </a>
          </span>
        </li>
      );
    })}
  </ul>
</div>
