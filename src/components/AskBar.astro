---
/**
 * The floating "Ask anything…" bar, present on every page as on America.gov.
 *
 * It searches the same index as the search dialog and answers facts inline,
 * each with its source. It needs JavaScript, so it is not rendered visible
 * without it; it steps aside while a page's own ask box is on screen.
 */
import Icon from './Icon.astro';
---

<div class="ask-bar" data-ask-bar data-inline-search>
  <ul id="askbar-results" class="search-results askbar-results" role="listbox" aria-label="Answers" data-limit="6" hidden></ul>
  <p id="askbar-status" class="visually-hidden" role="status" aria-live="polite"></p>
  <form role="search" aria-label="Ask about Calatagan">
    <label for="askbar-input" class="visually-hidden">Ask anything about Calatagan</label>
    <input
      id="askbar-input"
      type="text"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="askbar-results"
      aria-describedby="askbar-status"
      placeholder="Ask anything…"
      autocomplete="off"
      spellcheck="false"
    />
    <button class="ab-icon" type="button" data-voice hidden aria-label="Ask by voice" title="Ask by voice">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg>
    </button>
    <button class="ab-go" type="submit" aria-label="Search">
      <Icon name="arrow-right" size="17" />
    </button>
  </form>
</div>

<style>
  .ask-bar {
    position: fixed;
    left: 50%;
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    z-index: 35;
    display: none;
    width: min(28rem, calc(100vw - 1.5rem));
    transform: translateX(-50%);
    transition:
      opacity var(--dur-2) ease,
      transform var(--dur-2) var(--ease-out);
  }
  :global(.js) .ask-bar {
    display: block;
  }
  :global(body.menu-open) .ask-bar,
  :global(body.palette-open) .ask-bar {
    display: none;
  }
  .ask-bar.away {
    opacity: 0;
    transform: translate(-50%, 24px);
    pointer-events: none;
  }
  .ask-bar form {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 56px;
    padding: 0 10px 0 22px;
    border: 1px solid color-mix(in srgb, var(--c-ink) 28%, transparent);
    border-radius: 999px;
    background: var(--c-raised);
    box-shadow: 0 12px 32px -14px rgb(11 18 32 / 0.25);
    transition: border-color var(--dur-1);
  }
  .ask-bar form:focus-within {
    border-color: var(--c-ink);
    box-shadow: 0 22px 60px -18px rgb(11 18 32 / 0.34);
  }
  .ask-bar input {
    flex: 1;
    min-width: 0;
    height: 40px;
    border: 0;
    background: transparent;
    color: var(--c-ink);
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .ask-bar input:focus {
    outline: none;
  }
  .ask-bar input::placeholder {
    color: var(--c-muted);
  }
  .ab-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--c-ink);
    cursor: pointer;
    transition: background var(--dur-1);
  }
  .ab-icon[hidden] {
    display: none;
  }
  .ab-icon:hover {
    background: var(--c-sunk);
  }
  .ab-icon.listening {
    color: #fff;
    background: #c62828;
    animation: pulse-mic 1.2s ease-in-out infinite alternate;
  }
  @keyframes pulse-mic {
    to {
      box-shadow: 0 0 0 8px rgb(198 40 40 / 0.18);
    }
  }
  .ab-go {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: #0b2a6b;
    color: #fff;
    cursor: pointer;
    transition: transform var(--dur-2) var(--ease-out), background var(--dur-1);
  }
  :global([data-theme='dark']) .ab-go {
    background: var(--c-accent);
    color: var(--c-bg);
  }
  .ab-go:hover {
    background: #081f52;
    transform: scale(1.04);
  }
  @media (max-width: 40rem) {
    .ask-bar form {
      min-height: 60px;
      padding: 6px 6px 6px 20px;
    }
    .ab-go {
      width: 46px;
      height: 46px;
    }
  }
  .askbar-results {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 10px);
    max-height: min(26rem, 60vh);
    overflow-y: auto;
    padding: var(--sp-2);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-raised);
    box-shadow: var(--shadow-lg);
  }
</style>
