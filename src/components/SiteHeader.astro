---
/**
 * Site header: a one-line independence notice, then the masthead.
 *
 * The notice takes the place of the "An official website of the United
 * States government" line on federal sites and says the opposite, plainly,
 * with a disclosure explaining how to tell.
 *
 * The masthead floats over the top of each page's opening panel and becomes a
 * frosted bar once the page scrolls. Navigation works without JavaScript: an
 * inline list on wide screens and a native <details> menu everywhere else.
 */
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { NAV_GROUPS, OVERVIEW, SITE, isCurrent } from '../lib/site';

const pathname = Astro.url.pathname;
const groupCurrent = (items: readonly { href: string }[]) => items.some((item) => isCurrent(item.href, pathname));
---

<div class="gov-banner">
  <details class="how-to-tell">
    <summary>
      <span class="tell-long">An independent civic project — not an official government website</span>
      <span class="tell-short" aria-hidden="true">Independent project · not a government site</span>
      <span class="tell-i" aria-hidden="true"><Icon name="info" size="14" /></span>
      <span class="visually-hidden">How to tell</span>
    </summary>
    <div class="tell-panel">
      <div>
        <span class="tell-icon"><Icon name="landmark" /></span>
        <p>
          <strong>No seal, no .gov.ph address.</strong> Official municipal websites use a government
          domain and the municipal seal. This site uses neither, by design.
        </p>
      </div>
      <div>
        <span class="tell-icon"><Icon name="shield" /></span>
        <p>
          <strong>Every figure is sourced.</strong> Each number links to the government document it
          came from. Where they differ, the original document is authoritative.
        </p>
      </div>
      <div>
        <span class="tell-icon"><Icon name="code" /></span>
        <p>
          <strong>Open and volunteer-built.</strong> Part of the BetterGov.ph Better LGU community.
          <a href="/about">About this project</a>
        </p>
      </div>
    </div>
  </details>
  <span class="clock" data-ph-clock aria-hidden="true" hidden></span>
</div>

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="BetterCalatagan — home">
      <Mark size={44} />
      <span class="wordmark">BetterCalatagan</span>
    </a>

    <nav class="primary" aria-label="Primary">
      <ul class="nav-inline">
        <li>
          <a href={OVERVIEW.href} aria-current={isCurrent(OVERVIEW.href, pathname) ? 'page' : undefined}>
            {OVERVIEW.label}
          </a>
        </li>
        {NAV_GROUPS.map((group) => (
          <li>
            <details class="nav-drop" data-nav-drop>
              <summary class:list={{ current: groupCurrent(group.items) }}>
                {group.label}
                <Icon name="chevron-down" size="14" class="drop-caret" />
              </summary>
              <div class="drop-panel">
                <p class="drop-blurb">{group.blurb}</p>
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href} aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}>
                        <span class="drop-icon"><Icon name={item.icon} size="18" /></span>
                        <span class="drop-text">
                          <span class="drop-label">{item.label}</span>
                          <span class="drop-item-blurb">{item.blurb}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
        ))}
      </ul>
      <!-- One surface that glides between menus on pointer devices (scripts/ui.ts). -->
      <span class="nav-morph" aria-hidden="true"><span class="morph-caret"></span></span>
    </nav>

    <div class="actions">
      <button class="icon-button js-only" type="button" data-open-search aria-haspopup="dialog" aria-label="Search (Ctrl K)" title="Search">
        <Icon name="search" size="19" />
      </button>
      <button class="icon-button js-only theme-toggle" type="button" data-theme-toggle aria-label="Change theme">
        <span class="t-system"><Icon name="monitor" size="19" /></span>
        <span class="t-light"><Icon name="sun" size="19" /></span>
        <span class="t-dark"><Icon name="moon" size="19" /></span>
      </button>

      <details class="nav-menu">
        <summary>
          <span class="menu-word">Menu</span>
          <span class="burger" aria-hidden="true"><span></span><span></span></span>
        </summary>
        <div class="menu-sheet">
          <nav class="menu-inner" aria-label="Menu">
            <ul class="menu-list">
              <li>
                <a href={OVERVIEW.href} aria-current={isCurrent(OVERVIEW.href, pathname) ? 'page' : undefined}>
                  <span class="menu-label">{OVERVIEW.label}</span>
                  <span class="menu-blurb">{OVERVIEW.blurb}</span>
                </a>
              </li>
            </ul>
            {NAV_GROUPS.map((group) => (
              <section class="menu-group" aria-label={group.label}>
                <p class="menu-group-title">{group.label}</p>
                <ul class="menu-list compact">
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href} aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}>
                        <span class="menu-label">{item.label}</span>
                        <span class="menu-blurb">{item.blurb}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
            <ul class="menu-secondary">
              <li><a href={SITE.repository}>Source code</a></li>
              <li><a href={`${SITE.repository}/issues/new/choose`}>Report a correction</a></li>
            </ul>
            <p class="menu-theme js-only">
              <button type="button" class="button small" data-theme-toggle aria-label="Change theme">
                <span class="t-system"><Icon name="monitor" size="16" /> System theme</span>
                <span class="t-light"><Icon name="sun" size="16" /> Light theme</span>
                <span class="t-dark"><Icon name="moon" size="16" /> Dark theme</span>
              </button>
            </p>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  /* ---------- Independence notice ---------- */
  .gov-banner {
    position: relative;
    z-index: 25;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 34px;
    padding: 6px var(--gutter);
    background: var(--c-bg);
    color: var(--c-muted);
    font-size: var(--fs-xs);
    text-align: center;
  }
  .how-to-tell > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 24px;
    border-radius: 999px;
  }
  .how-to-tell > summary:hover {
    color: var(--c-ink);
  }
  .tell-short {
    display: none;
  }
  @media (max-width: 40rem) {
    .tell-long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .tell-short {
      display: inline;
    }
  }
  .tell-i {
    display: inline-grid;
    place-items: center;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .how-to-tell[open] .tell-i {
    transform: rotate(180deg);
    color: var(--c-accent);
  }
  .tell-panel {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: calc(100% + 4px);
    z-index: 40;
    display: grid;
    gap: var(--sp-5);
    padding: var(--sp-6);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-xl);
    background: var(--c-raised);
    box-shadow: var(--shadow-lg);
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    text-align: left;
    animation: drop var(--dur-2) var(--ease-out);
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (min-width: 48rem) {
    .tell-panel {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 64rem;
      margin-inline: auto;
    }
  }
  .tell-panel > div {
    display: flex;
    gap: var(--sp-3);
    align-items: flex-start;
  }
  .tell-panel p {
    margin: 0;
  }
  .tell-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--c-accent-wash);
    color: var(--c-accent);
  }
  .tell-panel strong {
    display: block;
    color: var(--c-ink);
    margin-bottom: 2px;
  }
  .clock {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 64rem) {
    .clock {
      display: none;
    }
  }

  /* ---------- Masthead ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    /* Float over the opening panel of each page. */
    margin-bottom: calc(-1 * var(--header-h));
    padding-inline: calc(var(--gutter) * 0.75);
    transition:
      background var(--dur-2) ease,
      box-shadow var(--dur-2) ease;
  }
  :global(.site-header.scrolled) {
    background: color-mix(in srgb, var(--c-bg) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 var(--c-line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    min-height: var(--header-h);
    max-width: var(--w-wide);
    margin-inline: auto;
    padding-inline: calc(var(--gutter) * 1.25);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--c-ink);
    text-decoration: none;
    min-height: var(--tap);
    margin-right: auto;
    flex: none;
  }
  .brand :global(svg) {
    border-radius: 8px;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .brand:hover :global(svg) {
    transform: rotate(-6deg);
  }
  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  @media (max-width: 24rem) {
    .wordmark {
      font-size: 1.2rem;
    }
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    margin-top: 0;
  }

  .primary {
    display: none;
    position: relative;
  }
  @media (min-width: 72rem) {
    .primary {
      display: block;
    }
  }
  .nav-inline {
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-surface) 70%, transparent);
    border: 1px solid var(--c-line);
  }
  .nav-inline a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--sp-4);
    border-radius: 999px;
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-1), background var(--dur-1);
  }
  .nav-inline a:hover {
    color: var(--c-ink);
    background: var(--c-sunk);
  }
  .nav-inline a[aria-current='page'],
  .nav-drop > summary.current {
    color: var(--c-bg);
    background: var(--c-ink);
  }

  /* Grouped menus: native disclosures, so they open without JavaScript. */
  .nav-inline > li {
    position: relative;
  }
  .nav-drop > summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 36px;
    padding: 0 var(--sp-3) 0 var(--sp-4);
    border-radius: 999px;
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-1), background var(--dur-1);
  }
  .nav-drop > summary::-webkit-details-marker {
    display: none;
  }
  .nav-drop > summary:hover,
  .nav-drop[open] > summary:not(.current) {
    color: var(--c-ink);
    background: var(--c-sunk);
  }
  .nav-drop :global(.drop-caret) {
    transition: transform var(--dur-2) var(--ease-out);
  }
  .nav-drop[open] :global(.drop-caret) {
    transform: rotate(180deg);
  }
  .drop-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 40;
    width: 22rem;
    padding: var(--sp-3);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-raised);
    box-shadow: var(--shadow-lg);
    transform: translateX(-50%);
    animation: drop-in 200ms var(--ease-out);
  }
  /* ---- The morphing surface (pointer devices, JS on) ----
     In morph mode each group's own panel loses its chrome and the shared
     .nav-morph draws the card behind it, animating between groups. */
  .nav-morph {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 39;
    width: var(--mw, 0px);
    height: var(--mh, 0px);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-raised);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transform: translate(var(--mx, 0px), var(--my, 0px)) scale(0.97);
    transform-origin: var(--mo, 50%) 0;
    pointer-events: none;
    transition:
      transform 340ms cubic-bezier(0.22, 1, 0.36, 1),
      width 340ms cubic-bezier(0.22, 1, 0.36, 1),
      height 340ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 160ms ease;
  }
  .primary:global(.morph-open) .nav-morph {
    opacity: 1;
    transform: translate(var(--mx, 0px), var(--my, 0px)) scale(1);
  }
  .primary:global(.morph-instant) .nav-morph {
    transition: opacity 160ms ease, transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .morph-caret {
    position: absolute;
    top: -6px;
    left: var(--caret, 50%);
    width: 12px;
    height: 12px;
    border-top: 1px solid var(--c-line);
    border-left: 1px solid var(--c-line);
    border-radius: 3px 0 0 0;
    background: var(--c-raised);
    transform: translateX(-50%) rotate(45deg);
    transition: left 340ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .primary:global(.morph-mode) .drop-panel {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    animation: none;
  }
  .primary:global(.morph-mode:not(.morph-open)) .drop-panel {
    opacity: 0;
    transition: opacity 140ms ease;
  }
  .primary:global(.morph-mode) .drop-panel > * {
    animation: drop-content 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .primary:global([data-dir='right']) .drop-panel > * {
    --from: 28px;
  }
  .primary:global([data-dir='left']) .drop-panel > * {
    --from: -28px;
  }
  @keyframes drop-content {
    from {
      opacity: 0;
      transform: translateX(var(--from, 0px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-morph,
    .morph-caret {
      transition: opacity 120ms ease;
    }
    .primary:global(.morph-mode) .drop-panel > * {
      animation: none;
    }
  }

  /* An invisible bridge over the gap, so moving down to the panel keeps it open. */
  .drop-panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 12px;
  }
  .nav-inline > li:last-child .drop-panel {
    left: auto;
    right: -4px;
    transform: none;
    animation-name: drop-in-right;
  }
  @keyframes drop-in {
    from {
      opacity: 0;
      transform: translate(-50%, -6px);
    }
  }
  @keyframes drop-in-right {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .drop-blurb {
    margin: 0 0 var(--sp-2);
    padding: var(--sp-1) var(--sp-3) var(--sp-2);
    border-bottom: 1px solid var(--c-line);
    font-size: var(--fs-2xs);
    color: var(--c-muted);
  }
  .drop-panel ul {
    display: grid;
    gap: 2px;
  }
  .drop-panel a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    align-items: start;
    min-height: 0;
    padding: var(--sp-3);
    border-radius: var(--radius-md);
    color: var(--c-ink);
    background: transparent;
  }
  .drop-panel a:hover,
  .drop-panel a:focus-visible {
    background: var(--c-accent-wash);
    color: var(--c-ink);
  }
  .drop-panel a[aria-current='page'] {
    background: var(--c-sunk);
    color: var(--c-ink);
  }
  .drop-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: var(--c-sunk);
    color: var(--c-accent);
  }
  .drop-text {
    display: grid;
    gap: 1px;
  }
  .drop-label {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-navy);
  }
  .drop-item-blurb {
    font-size: var(--fs-2xs);
    line-height: 1.4;
    color: var(--c-muted);
    white-space: normal;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .js-only {
    display: none;
  }
  :global(.js) .js-only {
    display: inline-flex;
  }
  .icon-button {
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--c-line);
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-surface) 70%, transparent);
    color: var(--c-ink);
    cursor: pointer;
    transition: background var(--dur-1), border-color var(--dur-1);
  }
  .icon-button:hover {
    border-color: var(--c-ink);
    background: var(--c-surface);
  }
  [data-theme-toggle] > span {
    display: none;
    align-items: center;
    gap: var(--sp-2);
  }
  [data-theme-toggle]:not([data-state]) .t-system,
  [data-theme-toggle][data-state='system'] .t-system,
  [data-theme-toggle][data-state='light'] .t-light,
  [data-theme-toggle][data-state='dark'] .t-dark {
    display: inline-flex;
  }
  .menu-theme {
    margin: var(--sp-5) 0 0;
  }
  :global(.js) .menu-theme.js-only {
    display: block;
  }
  .nav-menu:not([open]) .menu-sheet {
    display: none;
  }

  /* Phones: a tighter masthead; the theme switch moves into the menu. */
  @media (max-width: 40rem) {
    .site-header {
      padding-inline: var(--gutter);
    }
    .header-inner {
      padding-inline: 0;
      gap: var(--sp-2);
    }
    .wordmark {
      font-size: 1.25rem;
    }
    .theme-toggle {
      display: none !important;
    }
  }
  /* Standard phones (360–400 px): brand, search and Menu must share one row. */
  @media (max-width: 25rem) {
    .brand {
      gap: var(--sp-2);
    }
    .wordmark {
      font-size: 1.1rem;
    }
    .nav-menu > summary {
      padding: 0 var(--sp-4);
    }
  }
  @media (max-width: 23rem) {
    .brand {
      gap: var(--sp-2);
    }
    .menu-word {
      display: none;
    }
    .nav-menu > summary {
      padding: 0 var(--sp-3);
    }
  }

  /* ---------- Menu ---------- */
  @media (min-width: 72rem) {
    .nav-menu {
      display: none;
    }
  }
  .nav-menu > summary {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: 0 var(--sp-5);
    border-radius: 999px;
    background: var(--c-accent);
    color: var(--c-bg);
    font-size: var(--fs-sm);
    font-weight: 600;
    transition: background var(--dur-1);
  }
  .nav-menu > summary:hover {
    background: var(--c-accent-strong);
  }
  .burger {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }
  .burger span {
    display: block;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .nav-menu[open] .burger span:nth-child(1) {
    transform: translateY(2.75px) rotate(45deg);
  }
  .nav-menu[open] .burger span:nth-child(2) {
    transform: translateY(-2.75px) rotate(-45deg);
  }
  .menu-sheet {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--c-bg);
    border-top: 1px solid var(--c-line);
    animation: sheet-in var(--dur-2) var(--ease-out);
  }
  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .menu-inner {
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--sp-6) var(--gutter) var(--sp-9);
  }
  .menu-list a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--c-line);
    text-decoration: none;
    color: var(--c-ink);
  }
  .menu-label {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.1;
    transition: color var(--dur-1);
  }
  .menu-list a:hover .menu-label,
  .menu-list a[aria-current='page'] .menu-label {
    color: var(--c-accent);
  }
  .menu-blurb {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }
  .menu-group {
    margin-top: var(--sp-6);
  }
  .menu-group-title {
    margin: 0 0 var(--sp-1);
    font-size: var(--fs-2xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
