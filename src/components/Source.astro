---
/**
 * Provenance for one civic record, as a small chip that opens in place.
 *
 * Always visible: who published it, whether it was verified and when, and,
 * for tier 2, the caveat (one line, in full once opened). One click opens
 * the status, dates, note, method and every source with its locator and
 * checksum, so a primary source is never more than one interaction away.
 */
import type { DataSource } from '../data/types/provenance';
import Freshness from './Freshness.astro';
import AgencyBadge, { agencyOf } from './AgencyBadge.astro';
import Icon from './Icon.astro';
import { formatDate } from '../lib/format';

interface Props {
  source: DataSource;
  /** Short name for what this block describes, used in the disclosure label. */
  label?: string;
  /**
   * Set false only where the page already states the note in full right
   * beside the figure, so the reader is not shown the same paragraph twice.
   */
  showNote?: boolean;
}
const { source, label = 'this data', showNote = true } = Astro.props;
const [primary, ...others] = source.sources;
const agency = agencyOf(primary.publisher);

const checked = formatDate(source.lastVerified);
const verification =
  source.verification === 'verified'
    ? `Verified ${checked}`
    : source.verification === 'reported'
      ? `Reported ${checked}, not yet confirmed`
      : `Unverified, last checked ${checked}`;
const REFRESH: Record<DataSource['expectedRefresh'], string> = {
  quarterly: 'Updated quarterly',
  annual: 'Updated yearly',
  'per-census': 'Updated each census',
  'per-election': 'Updated each election',
  'per-issuance': 'Updated with each issuance',
  irregular: 'Updated as sources change',
  none: 'Updated only when corrected',
};
// asOf is a date for most records, or a phrase ("Executive orders in force")
// where the data describes a state rather than a day.
const asOf = source.asOf
  ? /^\d{4}-\d{2}(-\d{2})?$/.test(source.asOf)
    ? `Data as of ${formatDate(source.asOf)}`
    : source.asOf
  : null;
const TONES: Record<DataSource['status'], string> = {
  current: 'ok',
  'latest-official': 'ok',
  historical: 'neutral',
  archived: 'warn',
  draft: 'warn',
  unverified: 'warn',
};
const tone = source.verification === 'verified' ? TONES[source.status] : 'warn';
---

<details class="provenance" aria-label={`Source for ${label}`}>
  <summary class="prov-chip">
    <span class="prov-mark" aria-hidden="true">
      {agency ? <AgencyBadge agency={agency} size="1.4rem" /> : <span class="prov-icon"><Icon name="shield" size="12" /></span>}
    </span>
    <span class="prov-key">Source</span>
    <span class="prov-pub">{primary.publisher}</span>
    {others.length > 0 && <span class="prov-count">+{others.length}</span>}
    <span class={`prov-state ${tone}`}><span class="dot" aria-hidden="true"></span>{verification}</span>
    <span class="visually-hidden">: show method and sources for {label}</span>
    <Icon name="chevron-down" size="14" class="prov-chev" />
    {source.caveat && (
      <span class="prov-caveat"><Icon name="alert" size="13" /><span><span class="visually-hidden">Caveat: </span>{source.caveat}</span></span>
    )}
  </summary>
  <div class="prov-detail">
    <p class="prov-status-line"><Freshness source={source} /></p>
    <dl class="prov-facts">
      {asOf && <div><dt>Data</dt><dd>{asOf}</dd></div>}
      <div><dt>Checked</dt><dd>{verification}</dd></div>
      <div><dt>Refresh</dt><dd>{REFRESH[source.expectedRefresh]}</dd></div>
    </dl>
    {showNote && source.note && <p>{source.note}</p>}
    {source.methodology && <p>{source.methodology}</p>}
    <ol class="prov-sources">
      {source.sources.map((reference) => (
        <li>
          <a href={reference.url} rel="noopener noreferrer nofollow">{reference.name}</a>
          <span class="ref-meta">
            {[reference.publisher, reference.locator, `Accessed ${formatDate(reference.accessedOn)}`].filter(Boolean).join(' · ')}
          </span>
          {reference.sha256 && <span class="hash">SHA-256 {reference.sha256}</span>}
        </li>
      ))}
    </ol>
    <p class="prov-foot"><a href="/sources">About our sources</a></p>
  </div>
</details>

<style>
  .provenance {
    width: fit-content;
    max-width: min(46rem, 100%);
    margin-block: var(--sp-4) var(--sp-6);
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface);
    font-size: var(--fs-xs);
    line-height: 1.5;
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .provenance:has(.prov-caveat) {
    border-radius: var(--radius-lg);
  }
  .provenance:hover {
    border-color: var(--c-line-strong);
  }
  .provenance[open] {
    width: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm, none);
  }
  .prov-chip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px var(--sp-2);
    min-height: 36px;
    padding: 4px var(--sp-3) 4px 6px;
    color: var(--c-muted);
    cursor: pointer;
    list-style: none;
    border-radius: inherit;
  }
  .prov-chip::-webkit-details-marker {
    display: none;
  }
  .prov-chip:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
  .prov-mark {
    display: inline-flex;
  }
  .prov-icon {
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--c-accent-wash);
    color: var(--c-accent);
  }
  .prov-pub {
    font-weight: 600;
    color: var(--c-ink);
  }
  .prov-count {
    color: var(--c-muted);
  }
  .prov-state {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .prov-state::before {
    content: '·';
    margin-right: 0.25em;
    color: var(--c-line-strong);
  }
  .prov-state .dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--c-muted);
  }
  .prov-state.ok .dot {
    background: var(--c-ok);
  }
  .prov-state.warn .dot {
    background: var(--c-warn);
  }
  .prov-chip :global(.prov-chev) {
    margin-left: auto;
    color: var(--c-accent);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .provenance[open] .prov-chip :global(.prov-chev) {
    transform: rotate(180deg);
  }
  .prov-caveat {
    display: flex;
    flex-basis: 100%;
    gap: 6px;
    align-items: flex-start;
    padding: 0 var(--sp-2) 4px calc(1.4rem + var(--sp-2));
    color: var(--c-ink-2);
    line-height: 1.55;
  }
  .prov-caveat :global(.icon) {
    flex: none;
    margin-top: 2px;
    color: var(--c-warn);
  }
  .provenance:not([open]) .prov-caveat > span {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .prov-detail {
    display: grid;
    gap: var(--sp-3);
    margin: 0 var(--sp-4) var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--c-line);
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    animation: prov-in var(--dur-2) var(--ease-out);
  }
  @keyframes prov-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .prov-detail p {
    margin: 0;
  }
  .prov-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-6);
    margin: 0;
  }
  .prov-facts dt {
    color: var(--c-muted);
    font-size: var(--fs-2xs, 0.7rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .prov-facts dd {
    margin: 0;
    color: var(--c-ink);
  }
  .prov-sources {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    padding-left: 1.2em;
  }
  .prov-sources li + li {
    margin-top: 0;
  }
  .ref-meta {
    display: block;
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }
  .hash {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--c-muted);
    overflow-wrap: anywhere;
  }
  .prov-foot {
    font-size: var(--fs-xs);
  }
  @media (prefers-reduced-motion: reduce) {
    .prov-detail {
      animation: none;
    }
  }
  @media (max-width: 40rem) {
    .prov-state::before {
      display: none;
    }
    .provenance {
      width: auto;
      border-radius: var(--radius-lg);
    }
    .prov-caveat {
      padding-left: 2px;
    }
    .provenance:not([open]) .prov-caveat > span {
      -webkit-line-clamp: 2;
    }
  }
</style>
