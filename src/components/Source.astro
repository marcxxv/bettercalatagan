---
import type { DataSource } from '../data/types/provenance';
import Freshness from './Freshness.astro';

interface Props {
  source: DataSource;
}
const { source } = Astro.props;
---

<aside class="prov">
  <Freshness source={source} />

  {source.caveat && <p class="caveat"><strong>Caveat:</strong> {source.caveat}</p>}

  <dl>
    {source.asOf && (
      <>
        <dt>Data as of</dt>
        <dd>{source.asOf}</dd>
      </>
    )}
    <dt>Last verified</dt>
    <dd>{source.lastVerified}</dd>
    {source.methodology && (
      <>
        <dt>Method</dt>
        <dd>{source.methodology}</dd>
      </>
    )}
    <dt>{source.sources.length === 1 ? 'Source' : 'Sources'}</dt>
    <dd>
      <ul>
        {source.sources.map((reference) => (
          <li>
            <a href={reference.url} rel="noopener noreferrer nofollow">{reference.name}</a>
            <span class="pub"> — {reference.publisher}</span>
            {reference.locator && <span class="pub"> ({reference.locator})</span>}
            <span class="pub"> · accessed {reference.accessedOn}</span>
            {reference.archiveUrl && (
              <> · <a href={reference.archiveUrl} rel="noopener noreferrer nofollow">archived copy</a></>
            )}
          </li>
        ))}
      </ul>
    </dd>
  </dl>
</aside>

<style>
  .prov {
    border-left: 3px solid var(--line);
    padding: 2px 0 2px 14px;
    margin-block: 14px 28px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .caveat {
    background: var(--warn-bg);
    border: 1px solid var(--warn-line);
    border-radius: 4px;
    padding: 8px 10px;
    color: var(--fg);
    margin-block: 8px;
  }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 3px 14px; margin: 6px 0 0; }
  dt { font-weight: 600; }
  dd { margin: 0; }
  ul { margin: 0; padding-left: 18px; }
  .pub { color: var(--muted); }
  @media (max-width: 460px) {
    dl { grid-template-columns: 1fr; }
    dd { margin-bottom: 8px; }
  }
</style>
