---
import Base from '../layouts/Base.astro';
import Source from '../components/Source.astro';
import Contours from '../components/Contours.astro';
import Icon from '../components/Icon.astro';
import ColumnChart from '../components/ColumnChart.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import AgencyBadge, { type AgencyKey } from '../components/AgencyBadge.astro';
import { barangays } from '../data/barangays';
import {
  barangayPopulation2024,
  censusDefinitions,
  outsideHouseholds,
  population2024,
  populationSeries,
} from '../data/population';
import { incomeClassification, municipality, WITHHELD } from '../data/municipality';
import { fdpSummary } from '../data/fdp';
import { annualSeries, verifiedFilings } from '../data/financials';
import { archivedDocuments } from '../data/documents';
import { orderedCitations, timeline } from '../data/history';
import { formatDate, formatNumber, formatPesoMillions, ordinal } from '../lib/format';
import { ASK, NAV_GROUPS, SITE } from '../lib/site';
import { offices, publicServiceCount } from '../data/services';
import { cmciYears, latestCmci } from '../data/competitiveness';
import { inCalatagan } from '../data/infrastructure';
import { holidays } from '../data/calendar';

const populationByCode = new Map(barangayPopulation2024.data.map((row) => [row.psgc10, row]));
const barangayRows = [...barangays.data]
  .map((barangay) => ({ ...barangay, census: populationByCode.get(barangay.psgc10) }))
  .sort((a, b) => a.name.localeCompare(b.name));
const barangayTotal = barangayRows.reduce((sum, row) => sum + (row.census?.totalPopulation ?? 0), 0);
const institutionalCodes = new Set(outsideHouseholds.map((b) => b.psgc10));
const largest = Math.max(...barangayRows.map((row) => row.census?.totalPopulation ?? 0));

const yearsLabel = (years: number[]) =>
  years.length ? `CY${Math.min(...years)}–CY${Math.max(...years)}` : '';

const pop = population2024.data;
const series = [...populationSeries.data].sort((a, b) => a.referenceDate.localeCompare(b.referenceDate));
const first = series[0];
const last = series[series.length - 1];
const growth = first && last ? ((last.population - first.population) / first.population) * 100 : null;
// Household size from PSA's own household population and household counts.
const householdSize = pop.householdPopulation / pop.households;

const totalChecks = verifiedFilings.reduce((sum, f) => sum + f.reconciliation.total, 0);
const years = annualSeries();

/** What each section holds, counted from the data rather than written by hand. */
const counts: Record<string, string> = {
  '/history': `${orderedCitations.length} cited sources`,
  '/government': 'What can and cannot be verified',
  '/finances': `${verifiedFilings.length} quarterly statements`,
  '/transparency': `${formatNumber(fdpSummary.total)} filings, ${yearsLabel(fdpSummary.years)}`,
  '/documents': `${formatNumber(archivedDocuments.documents.length)} archived documents`,
  '/sources': `${WITHHELD.length} items deliberately withheld`,
  '/services': `${publicServiceCount} services from ${offices.length} offices`,
  '/barangays': `${barangays.data.length} barangay profiles`,
  '/statistics': `DTI competitiveness, ${cmciYears[0].year}–${latestCmci.year}`,
  '/infrastructure': `${inCalatagan.length} DPWH projects`,
  '/legislation': 'Ordinances, resolutions, executive orders',
  '/procurement': 'Notices of award and bidding',
  '/hotlines': '911 and local lines',
  '/holidays': `${holidays.length} dates this year`,
};
/** Plain-language shortcuts for the four things people most often come for. */
const TASKS: { label: string; href: string; icon: Parameters<typeof Icon>[0]['name'] }[] = [
  { label: 'get a certificate or permit', href: '/services', icon: 'file' },
  { label: 'call for help', href: '/hotlines', icon: 'alert' },
  { label: 'find my barangay', href: '/barangays', icon: 'pin' },
  { label: 'see where the money goes', href: '/finances', icon: 'coins' },
];

/** The menu's groups, so the home page teaches the navigation. */
const GROUP_ICON: Record<string, Parameters<typeof Icon>[0]['name']> = {
  Services: 'layers',
  Government: 'landmark',
  Statistics: 'chart',
  Transparency: 'shield',
};
const GROUPS = NAV_GROUPS.filter((g) => g.label in GROUP_ICON).map((g) => ({
  ...g,
  key: g.label.toLowerCase(),
  icon: GROUP_ICON[g.label],
}));


const MILESTONE_DATES = ['Late 14th – mid 15th century', '1890', '23 October 1903', '1 January 1912', '2018', '1 July 2024'];
const milestones = MILESTONE_DATES.map((when) => timeline.find((t) => t.when === when)).filter(
  (t): t is (typeof timeline)[number] => Boolean(t),
);

/** The manifesto, word by word, with inline marks. */
type Token = string | { mark: 'arrow' | 'sources' | 'check' };
const manifesto: Token[] = [
  'BetterCalatagan',
  { mark: 'arrow' },
  'gathers the town’s public record and gives answers only from',
  { mark: 'sources' },
  'official sources. It’s free, runs no ads, tracks no one, and shows',
  { mark: 'check' },
  'where every figure came from.',
];
const agencies: AgencyKey[] = ['psa', 'dilg', 'blgf'];
const ring: AgencyKey[] = ['psa', 'dilg', 'blgf', 'dof', 'nhcp', 'ia'];

const description =
  'Calatagan, Batangas in verified public data: 2024 population, 25 barangays, income class, finances, Full Disclosure filings and history, each linked to its source.';

const origin = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Calatagan, Batangas — 2024 population by barangay',
    description: `Total population, household population and households for each of Calatagan’s ${barangays.data.length} barangays, from the Philippine Statistics Authority’s ${pop.census}, as republished by ${SITE.name} with provenance.`,
    url: new URL('/#barangays', origin).toString(),
    isAccessibleForFree: true,
    creator: { '@type': 'Organization', name: 'Philippine Statistics Authority', url: 'https://psa.gov.ph' },
    publisher: { '@type': 'Organization', name: SITE.name },
    temporalCoverage: '2024',
    spatialCoverage: { '@type': 'Place', name: 'Calatagan, Batangas, Philippines' },
    isBasedOn: barangayPopulation2024.source.sources.map((s) => s.url),
    distribution: [
      {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: new URL('/data/municipality.json', origin).toString(),
      },
    ],
  },
];
---

<Base title="Overview" {description} {jsonLd}>
  <!-- ============ Hero ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-panel">
      <Contours lines={12} focus={0.72} />
      <div class="hero-inner">
        <h1 id="hero-title">
          <span class="hello">Kumusta, Calatagan</span>
          <span class="visually-hidden">— </span>
          <span class="hero-sub">Calatagan, Batangas, in the public record. Every figure traced to its source.</span>
        </h1>
        <HeroCarousel />
      </div>
    </div>
  </section>

  <!-- ============ Manifesto ============ -->
  <section class="manifesto-wrap" aria-label="What this site is">
    <p class="manifesto" data-manifesto>
      {manifesto.map((token) =>
        typeof token === 'string' ? (
          token.split(' ').map((word) => <><span class="w">{word}</span>{' '}</>)
        ) : token.mark === 'arrow' ? (
          <><span class="pill pill-arrow" aria-hidden="true"><Icon name="arrow-right" /></span>{' '}</>
        ) : token.mark === 'sources' ? (
          <>
            <span class="pill pill-seals">
              {agencies.map((a) => <AgencyBadge agency={a} size="0.95em" class="badge" />)}
            </span>{' '}
          </>
        ) : (
          <><span class="pill pill-check" aria-hidden="true"><Icon name="check" /></span>{' '}</>
        ),
      )}
    </p>
  </section>

  <!-- ============ Feature rows ============ -->
  <section class="features" aria-label="How BetterCalatagan works">
    <article class="feature" data-reveal>
      <div class="f-visual f-stack" aria-hidden="true">
        <div class="stack-card s1"><span>Census</span><strong>PSA</strong></div>
        <div class="stack-card s2"><span>Filings</span><strong>DILG</strong></div>
        <div class="stack-card s3"><span>Income class</span><strong>BLGF</strong></div>
        <div class="stack-card s4"><span>Former website</span><strong>Archive</strong></div>
        <div class="stack-core"><Icon name="layers" size="30" /></div>
      </div>
      <div class="f-copy">
        <h2>Scattered records, <br />in one place.</h2>
        <p>
          Census tables at the PSA, quarterly filings at the DILG, an income classification at the
          BLGF, and a municipal website that went offline. BetterCalatagan brings them together:
          {' '}{formatNumber(fdpSummary.total)} filings, {formatNumber(archivedDocuments.documentCount)} archived
          documents and {verifiedFilings.length} quarters of finances.
        </p>
        <a class="link-arrow" href="/transparency">Explore the disclosures</a>
      </div>
    </article>

    <article class="feature flip" data-reveal>
      <div class="f-visual f-night" aria-hidden="true">
        <svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
          {Array.from({ length: 60 }, (_, i) => (
            <circle cx={(i * 97) % 400} cy={(i * 53) % 260} r={i % 5 === 0 ? 1.4 : 0.8} fill="#fff" opacity={0.3 + ((i * 7) % 10) / 16} />
          ))}
          <circle cx="200" cy="300" r="120" fill="#dfe4ee" />
          <circle cx="200" cy="300" r="120" fill="url(#moonshade)" />
          <defs>
            <radialGradient id="moonshade" cx="0.35" cy="0.3">
              <stop offset="0.6" stop-color="#fff" stop-opacity="0" />
              <stop offset="1" stop-color="#8b95a8" stop-opacity="0.55" />
            </radialGradient>
          </defs>
        </svg>
        <span class="lock"><Icon name="eye-off" size="26" /></span>
      </div>
      <div class="f-copy">
        <h2>Nothing to sign in to. <br />Nothing tracked.</h2>
        <p>
          No accounts, no cookies, no analytics, no advertising. The site is plain pages and open
          data — what you look up stays with you{ASK.endpoint ? ', and questions you ask are answered, not kept' : ''}.
        </p>
        <a class="link-arrow" href="/about#privacy">How this site works</a>
      </div>
    </article>

    <article class="feature" data-reveal>
      <div class="f-visual f-ring" aria-hidden="true">
        <div class="ring-orbit">
          {ring.map((a, i) => (
            <span class="orbit-badge" style={`--i:${i};--n:${ring.length}`}><span><AgencyBadge agency={a} size="100%" /></span></span>
          ))}
        </div>
        <span class="ring-core"><Icon name="shield" size="34" /></span>
      </div>
      <div class="f-copy">
        <h2>Clear answers. <br />Official sources.</h2>
        <p>
          Every figure is read from the agency that published it, dated, and checked —
          {' '}{formatNumber(totalChecks)} arithmetic checks on the finances alone. Where something
          can’t be traced, it isn’t published, and we say why.
        </p>
        <a class="link-arrow" href="/sources">See every source</a>
      </div>
    </article>
  </section>

  <!-- ============ At a glance ============ -->
  <section class="section glance-sec" aria-labelledby="glance-title">
    <div class="container wide">
      <header class="center-head">
        <h2 id="glance-title">Calatagan at a glance</h2>
        <p>The municipality in five official figures.</p>
      </header>
      <dl class="glance-grid" data-stagger="70">
        <div class="g-item" data-reveal>
          <dt>Population</dt>
          <dd class="g-figure figure" data-count={pop.population}>{formatNumber(pop.population)}</dd>
          <dd class="g-note">{pop.census} · {formatDate(pop.referenceDate)}</dd>
        </div>
        <div class="g-item" data-reveal>
          <dt>Households</dt>
          <dd class="g-figure figure" data-count={pop.households}>{formatNumber(pop.households)}</dd>
          <dd class="g-note">{householdSize.toFixed(2)} persons per household</dd>
        </div>
        <div class="g-item" data-reveal>
          <dt>Barangays</dt>
          <dd class="g-figure figure" data-count={municipality.data.barangayCount}>{municipality.data.barangayCount}</dd>
          <dd class="g-note">PSGC {municipality.data.psgc10}</dd>
        </div>
        <div class="g-item" data-reveal>
          <dt>Income class</dt>
          <dd class="g-figure figure">{ordinal(incomeClassification.data.incomeClass)}</dd>
          <dd class="g-note">From {formatDate(incomeClassification.data.effectiveFrom)}</dd>
        </div>
        <div class="g-item" data-reveal>
          <dt>Disclosure filings</dt>
          <dd class="g-figure figure" data-count={fdpSummary.total}>{formatNumber(fdpSummary.total)}</dd>
          <dd class="g-note">{yearsLabel(fdpSummary.years)}</dd>
        </div>
      </dl>
      <p class="glance-foot">
        <Icon name="shield" size="16" />
        Philippine Statistics Authority · Bureau of Local Government Finance · DILG Full Disclosure
        Policy Portal. <a href="#population">How each figure was checked</a>
      </p>
    </div>
  </section>

  <!-- ============ Explore ============ -->
  <section class="section explore-sec" aria-labelledby="explore-title">
    <div class="container wide">
      <header class="section-head split">
        <h2 id="explore-title">Explore the public record</h2>
        <p class="lede">
          Start with what you need to do, or browse by section. Every figure carries its source and
          the date someone last checked it.
        </p>
      </header>

      <ul class="tasks" data-stagger="60" aria-label="Common tasks">
        {TASKS.map((task) => (
          <li data-reveal>
            <a class="task" href={task.href}>
              <span class="task-icon" aria-hidden="true"><Icon name={task.icon} size="22" /></span>
              <span class="task-text">
                <span class="task-want">I want to</span>
                <span class="task-label">{task.label}</span>
              </span>
              <span class="task-arrow" aria-hidden="true"><Icon name="arrow-right" size="18" /></span>
            </a>
          </li>
        ))}
      </ul>

      <div class="groups" data-stagger="80">
        {GROUPS.map((group) => (
          <section class="group" data-reveal aria-labelledby={`group-${group.key}`}>
            <header class="group-top">
              <span class="group-icon" aria-hidden="true"><Icon name={group.icon} size="24" /></span>
              <div>
                <h3 id={`group-${group.key}`}><a href={group.href}>{group.label}</a></h3>
                <p>{group.blurb}</p>
              </div>
            </header>
            <ul class="group-links">
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>
                    <span class="gl-label">{item.label}</span>
                    <span class="gl-count">{counts[item.href] ?? ''}</span>
                    <span class="gl-arrow" aria-hidden="true"><Icon name="arrow-right" size="15" /></span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Population ============ -->
  <section class="section" id="population" aria-labelledby="population-title">
    <div class="container wide pop-grid">
      <div class="pop-copy" data-reveal>
        <p class="eyebrow">People</p>
        <h2 id="population-title">Population</h2>
        <p class="lede">
          The latest official count is <strong>{formatNumber(pop.population)}</strong> people as of
          {' '}{formatDate(pop.referenceDate)}, in {formatNumber(pop.households)} households ({pop.census}).
        </p>
        {growth !== null && first && last && (
          <dl class="mini-stats">
            <div>
              <dt>Change since {first.referenceDate.slice(0, 4)}</dt>
              <dd class="figure">{growth > 0 ? '+' : ''}{growth.toFixed(1)}%</dd>
            </div>
            <div>
              <dt>Added since {first.referenceDate.slice(0, 4)}</dt>
              <dd class="figure">{growth > 0 ? '+' : ''}{formatNumber(last.population - first.population)}</dd>
            </div>
          </dl>
        )}
        <p class="small muted">
          Changes are calculated here from PSA’s published counts. Values between census years are
          not interpolated.
        </p>
      </div>
      <div class="card pop-chart" data-reveal>
        <ColumnChart
          caption="Population at each census"
          categories={series.map((e) => e.census)}
          series={[{ name: 'Population', color: 'var(--c-s1)', values: series.map((e) => e.population) }]}
          labels
          height={300}
          notes={series.map((e) => `Reference date ${formatDate(e.referenceDate)}`)}
        />
        <details class="data-table">
          <summary>View as a table</summary>
          <div class="table-wrap" role="region" aria-labelledby="series-caption" tabindex="0">
            <table>
              <caption id="series-caption">Population at each census</caption>
              <thead>
                <tr>
                  <th scope="col">Census</th>
                  <th scope="col">Reference date</th>
                  <th scope="col" class="num">Population</th>
                </tr>
              </thead>
              <tbody>
                {populationSeries.data.map((entry) => (
                  <tr>
                    <th scope="row">{entry.census}</th>
                    <td>{formatDate(entry.referenceDate)}</td>
                    <td class="num">{formatNumber(entry.population)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </div>
    </div>
    <div class="container wide">
      <Source source={population2024.source} label="the population figures" />
    </div>
  </section>

  <!-- ============ Barangays ============ -->
  <section class="section band-alt" id="barangays" aria-labelledby="barangays-title">
    <div class="container wide">
      <header class="section-head split">
        <div>
          <p class="eyebrow">Places</p>
          <h2 id="barangays-title">The {barangays.data.length} barangays</h2>
        </div>
        <p class="lede">
          From the {pop.census}. The barangays sum to {formatNumber(barangayTotal)}, matching the
          municipal total exactly. Search by name or code, and sort by any column.
        </p>
      </header>

      <div class="brgy-tools">
        <p class="field search">
          <label for="brgy-search">Find a barangay</label>
          <input id="brgy-search" type="search" placeholder="e.g. Balibago, Poblacion" autocomplete="off" />
        </p>
        <fieldset class="segmented">
          <legend>Show</legend>
          <label><input type="radio" name="brgy-view" value="all" checked /> All</label>
          <label><input type="radio" name="brgy-view" value="pob" /> Poblacion</label>
          <label><input type="radio" name="brgy-view" value="rural" /> Outside Poblacion</label>
        </fieldset>
        <p class="brgy-count" role="status" aria-live="polite" data-brgy-count></p>
      </div>

      <div class="table-wrap" role="region" aria-labelledby="barangay-caption" tabindex="0">
        <table class="barangays" data-sortable>
          <caption id="barangay-caption">
            Barangays of Calatagan by population, {pop.census}
            <span class="scroll-hint">Scroll sideways to see every column.</span>
          </caption>
          <thead>
            <tr>
              <th scope="col" data-sort="name" aria-sort="ascending">
                <button type="button">Barangay <Icon name="sort" size="14" /></button>
              </th>
              <th scope="col" class="num" data-sort="pop">
                <button type="button">Population <Icon name="sort" size="14" /></button>
              </th>
              <th scope="col" class="share-col">Share of municipality</th>
              <th scope="col" class="num" data-sort="hh">
                <button type="button">Households <Icon name="sort" size="14" /></button>
              </th>
              <th scope="col" class="num" data-sort="size">
                <button type="button">Per household <Icon name="sort" size="14" /></button>
              </th>
            </tr>
          </thead>
          <tbody>
            {barangayRows.map((row) => {
              const total = row.census?.totalPopulation ?? 0;
              const hh = row.census?.households ?? 0;
              const hhPop = row.census?.householdPopulation ?? 0;
              const size = hh > 0 ? hhPop / hh : null;
              const share = barangayTotal > 0 ? (total / barangayTotal) * 100 : 0;
              const isPob = /Pob\./.test(row.name);
              return (
                <tr
                  id={`brgy-${row.psgc10}`}
                  data-name={row.name.toLowerCase()}
                  data-search={[row.name, ...row.aliases, row.psgc10].join(' ').toLowerCase()}
                  data-pop={total}
                  data-hh={hh}
                  data-size={size ?? -1}
                  data-pob={isPob ? '1' : '0'}
                >
                  <th scope="row">
                    <span class="b-name">{row.name}</span>
                    {isPob && <span class="chip navy">Poblacion</span>}
                    <span class="code">PSGC {row.psgc10}</span>
                  </th>
                  <td class="num">{row.census ? formatNumber(total) : '—'}</td>
                  <td class="share-col">
                    <span class="share">
                      <span class="share-bar" aria-hidden="true">
                        <span data-grow style={`width:${((total / largest) * 100).toFixed(1)}%`}></span>
                      </span>
                      <span class="share-val num">{share < 0.5 && share > 0 ? '<0.5' : share.toFixed(1)}%</span>
                    </span>
                  </td>
                  <td class="num">
                    {row.census ? formatNumber(hh) : '—'}
                    {institutionalCodes.has(row.psgc10) && (
                      <a href="#outside-households" class="fn">
                        <span aria-hidden="true">*</span>
                        <span class="visually-hidden">See the note on {row.name}’s households</span>
                      </a>
                    )}
                  </td>
                  <td class="num">{size !== null ? size.toFixed(2) : '—'}</td>
                </tr>
              );
            })}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Total</th>
              <td class="num">{formatNumber(barangayTotal)}</td>
              <td class="share-col"><span class="num">100%</span></td>
              <td class="num">{formatNumber(pop.households)}</td>
              <td class="num">{householdSize.toFixed(2)}</td>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="empty-state" data-brgy-empty hidden>
        <strong>No barangay matches.</strong> Try part of a name, or a PSGC code.
      </p>
      <p class="small muted brgy-note">
        “Per household” is PSA’s household population divided by its household count, calculated
        here. PSA codes are not a continuous run: 012, 024 and 025 are unassigned.
      </p>

      {outsideHouseholds.length > 0 && (
        <div class="callout navy fn-note" id="outside-households">
          <p>
            <strong aria-hidden="true">* </strong>
            {outsideHouseholds.map((b, i) => (
              <>
                {i > 0 && '; '}
                {b.name} is reported by PSA with {formatNumber(b.institutionalPopulation)} persons, no
                household population and no households
              </>
            ))}. This is what PSA publishes, not a gap in our data. PSA defines total population as
            household population plus institutional population, so these persons were enumerated
            outside private households. PSA does not say which institutional quarters they were in,
            and this site does not guess.
          </p>
          <details class="data-table">
            <summary>PSA’s definitions, verbatim</summary>
            <ul class="defs">
              <li>{censusDefinitions.totalPopulation}</li>
              <li>{censusDefinitions.householdPopulation}</li>
              <li>{censusDefinitions.institutionalPopulation}</li>
            </ul>
          </details>
        </div>
      )}
      <Source source={barangayPopulation2024.source} label="the barangay figures" showNote={false} />
    </div>
  </section>

  <!-- ============ History ============ -->
  <section class="section" aria-labelledby="history-title">
    <div class="container wide">
      <header class="section-head split">
        <div>
          <p class="eyebrow">History</p>
          <h2 id="history-title">Six centuries on the Calatagan peninsula</h2>
        </div>
        <p class="lede">
          Fifteenth-century graves that held pottery from Siam and Annam; a sugar estate; a
          lighthouse for ships bound for Manila; a town merged into Balayan, then restored.
        </p>
      </header>
      <ol class="rail-timeline" data-animate data-stagger="90">
        {milestones.map((m) => (
          <li data-reveal>
