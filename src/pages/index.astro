        </li>
      ))}
    </ul>
  </section>

  <script>
    import '../scripts/barangays.ts';

    // The manifesto lights up word by word as it scrolls through the viewport.
    const m = document.querySelector<HTMLElement>('[data-manifesto]');
    if (m && document.documentElement.classList.contains('js-motion')) {
      const words = [...m.querySelectorAll<HTMLElement>('.w, .pill')];
      m.classList.add('armed');
      let raf = 0;
      const update = () => {
        raf = 0;
        const box = m.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, (vh * 0.8 - box.top) / (box.height * 0.9)));
        const lit = Math.round(progress * words.length);
        words.forEach((w, i) => w.classList.toggle('lit', i < lit));
      };
      window.addEventListener('scroll', () => (raf ||= requestAnimationFrame(update)), { passive: true });
      update();
    }
  </script>
