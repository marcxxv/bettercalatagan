---
import Base from '../layouts/Base.astro';
import Source from '../components/Source.astro';
import { barangays } from '../data/barangays';
import {
  barangayPopulation2024,
  censusDefinitions,
  outsideHouseholds,
  population2024,
  populationSeries,
} from '../data/population';
import { incomeClassification, municipality } from '../data/municipality';

const ORDINAL = ['', '1st', '2nd', '3rd', '4th', '5th', '6th'];
const number = new Intl.NumberFormat('en-PH');

const populationByCode = new Map(
  barangayPopulation2024.data.map((row) => [row.psgc10, row]),
);
const barangayRows = [...barangays.data]
  .map((barangay) => ({ ...barangay, census: populationByCode.get(barangay.psgc10) }))
  .sort((a, b) => a.name.localeCompare(b.name));
const barangayTotal = barangayRows.reduce((sum, row) => sum + (row.census?.totalPopulation ?? 0), 0);
const institutionalCodes = new Set(outsideHouseholds.map((b) => b.psgc10));
---

<Base
  title="Overview"
  description="Verified public information about the Municipality of Calatagan, Batangas, with the source for every figure."
>
  <h1>Calatagan, Batangas</h1>
  <p class="lede">
    Better Calatagan collects public information about the Municipality of Calatagan and shows,
    for every figure, where it came from and how well it has been checked. It publishes only what
    it can trace to a source — and says plainly what it cannot.
  </p>

  <nav class="sections" aria-label="Sections">
    <a href="/government">
      <strong>Government</strong>
      <span>Who holds office, and what we cannot yet verify</span>
    </a>
    <a href="/finances">
      <strong>Finances</strong>
      <span>14 quarters of income and spending, every figure traceable</span>
    </a>
    <a href="/transparency">
      <strong>Filings</strong>
      <span>156 Full Disclosure filings, CY2022–CY2026</span>
    </a>
    <a href="/documents">
      <strong>Documents</strong>
      <span>232 documents saved from the municipality's dead website</span>
    </a>
  </nav>

  <h2>Identity</h2>
  <dl class="facts">
    <dt>Official name</dt>
    <dd>{municipality.data.officialName}</dd>
    <dt>Province</dt>
    <dd>{municipality.data.province}</dd>
    <dt>Region</dt>
    <dd>{municipality.data.region} ({municipality.data.regionName})</dd>
    <dt>PSGC</dt>
    <dd><code>{municipality.data.psgc10}</code> (10-digit) · <code>{municipality.data.psgc9}</code> (9-digit)</dd>
    <dt>Barangays</dt>
    <dd>{municipality.data.barangayCount}</dd>
  </dl>
  <Source source={municipality.source} />

  <h2>Income classification</h2>
  <p>
    Calatagan is a <strong>{ORDINAL[incomeClassification.data.incomeClass]} class municipality</strong>, effective{' '}
    {incomeClassification.data.effectiveFrom}. It was reclassified from{' '}
    {ORDINAL[incomeClassification.data.previousIncomeClass ?? 2]} class under{' '}
    {incomeClassification.data.legalBasis}.
  </p>
  <p class="src-note">Issuance: {incomeClassification.data.issuance}</p>
  <Source source={incomeClassification.source} />

  <h2>Population</h2>
  <p>
    The latest official count is
    <strong>{number.format(population2024.data.population)}</strong>
    as of {population2024.source.asOf}, in {number.format(population2024.data.households)} households
    ({population2024.data.census}).
  </p>
  <div class="scroll">
    <table>
      <thead>
        <tr><th scope="col">Census</th><th scope="col">Reference date</th><th scope="col" class="num">Population</th></tr>
      </thead>
      <tbody>
        {populationSeries.data.map((entry) => (
          <tr>
            <td>{entry.census}</td>
            <td>{entry.referenceDate}</td>
            <td class="num">{number.format(entry.population)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <Source source={population2024.source} />

  <h2>Barangays</h2>
  <p>
    Calatagan has {barangays.data.length} barangays. Their PSGC codes are not a continuous run —
    012, 024 and 025 are unassigned. Populations are from the {population2024.data.census} and sum
    to {number.format(barangayTotal)}, matching the municipal total.
  </p>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">Barangay</th>
          <th scope="col">PSGC</th>
          <th scope="col" class="num">Population</th>
          <th scope="col" class="num">Households</th>
        </tr>
      </thead>
      <tbody>
        {barangayRows.map((row) => (
          <tr>
            <td>{row.name}</td>
            <td><code>{row.psgc10}</code></td>
            <td class="num">{row.census ? number.format(row.census.totalPopulation) : '—'}</td>
            <td class="num">
              {row.census ? number.format(row.census.households) : '—'}
              {institutionalCodes.has(row.psgc10) && (
                <a href="#outside-households" class="fn" aria-label="See note on households">*</a>
              )}
            </td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" colspan="2">Total</th>
          <td class="num"><strong>{number.format(barangayTotal)}</strong></td>
          <td class="num"><strong>{number.format(population2024.data.households)}</strong></td>
        </tr>
      </tfoot>
    </table>
  </div>
  {outsideHouseholds.length > 0 && (
    <div class="fn-note" id="outside-households">
      <p>
        <strong>*</strong>
        {outsideHouseholds.map((b, i) => (
          <>
            {i > 0 && '; '}
            {b.name} is reported by PSA with {number.format(b.institutionalPopulation)} persons,
            no household population and no households
          </>
        ))}. This is what PSA publishes, not a gap in our data. PSA defines total population as
        household population plus institutional population, so these persons were enumerated
        outside private households. PSA does not say which institutional quarters they were in,
        and this site does not guess.
      </p>
      <p class="defs">PSA's definitions, verbatim:</p>
      <ul class="defs">
        <li>{censusDefinitions.totalPopulation}</li>
        <li>{censusDefinitions.householdPopulation}</li>
        <li>{censusDefinitions.institutionalPopulation}</li>
      </ul>
    </div>
  )}
  <Source source={barangayPopulation2024.source} />

  <p class="src-note">
    Land area is not published. See <a href="/sources">Sources</a> for why.
  </p>

  <style>
    .src-note { color: var(--muted); font-size: 0.88rem; margin-top: -0.5em; }
    .fn { margin-left: 2px; text-decoration: none; font-weight: 700; }
    .fn-note { font-size: 0.85rem; margin-top: 10px; }
    .fn-note p { margin: 0 0 6px; }
    .defs { color: var(--muted); }
    ul.defs { margin: 0 0 10px; padding-left: 18px; }
    .lede { font-size: 1.05rem; }
    nav.sections {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 10px;
      margin-block: 22px 28px;
    }
    nav.sections a {
      display: block;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 12px 14px;
      text-decoration: none;
      color: var(--fg);
    }
    nav.sections a:hover { border-color: var(--accent); }
    nav.sections strong { display: block; color: var(--accent); margin-bottom: 3px; }
    nav.sections span { font-size: 0.86rem; color: var(--muted); }
  </style>
</Base>
