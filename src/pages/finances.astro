---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Source from '../components/Source.astro';
import {
  annualSeries,
  filingRecord,
  financialsSource,
  headline,
  itemOf,
  latestFiling,
  sectorSpending,
  sreDataset,
  verifiedFilings,
} from '../data/financials';
import { formatNumber, formatPeso, formatPesoMillions } from '../lib/format';
import { SITE } from '../lib/site';

const pesoExact = new Intl.NumberFormat('en-PH', {
  style: 'currency',
  currency: 'PHP',
  minimumFractionDigits: 2,
});

const latest = latestFiling;
const latestHeadline = latest ? headline(latest) : null;
const period = latest ? `Q${latest.documentPeriod.quarter} CY${latest.documentPeriod.year}` : '';
const sectors = latest ? sectorSpending(latest) : [];
const sectorMax = Math.max(1, ...sectors.map((s) => s.value));
const sectorTotal = sectors.reduce((sum, s) => sum + s.value, 0);
const years = annualSeries();
const latestRecord = latest ? filingRecord(latest.filingId) : undefined;
const totalChecks = verifiedFilings.reduce((sum, f) => sum + f.reconciliation.total, 0);
const oldest = verifiedFilings[verifiedFilings.length - 1];

/**
 * Income composition, drawn only when the parts add exactly to the reported
 * total — a chart must never imply a split the filing does not state.
 */
const composition = (() => {
  if (!latestHeadline) return null;
  const { income, localSources, externalSources, nationalTaxAllotment } = latestHeadline;
  if (income === null || localSources === null || externalSources === null || nationalTaxAllotment === null)
    return null;
  if (localSources + externalSources !== income || nationalTaxAllotment > externalSources) return null;
  const parts = [
    { key: 'nta', label: 'National Tax Allotment', value: nationalTaxAllotment },
    { key: 'other-ext', label: 'Other national and external sources', value: externalSources - nationalTaxAllotment },
    { key: 'local', label: 'Raised locally (taxes, fees, receipts)', value: localSources },
  ].filter((p) => p.value > 0);
  return parts.map((p) => ({ ...p, share: (p.value / income) * 100 }));
})();

const externalShare =
  latestHeadline?.income && latestHeadline.externalSources !== null
    ? Math.round((latestHeadline.externalSources / latestHeadline.income) * 100)
    : null;

/** Income composition of the latest filing, in the Total column. */
const incomeRows = latest
  ? [
      'local-sources',
      'tax-revenue',
      'real-property-tax',
      'tax-on-business',
      'other-taxes',
      'non-tax-revenue',
      'regulatory-fees',
      'service-user-charges',
      'economic-enterprises',
      'other-receipts',
      'external-sources',
      'national-tax-allotment',
      'other-national-shares',
      'inter-local-transfers',
      'extraordinary-receipts',
      'total-current-operating-income',
    ]
      .map((key) => itemOf(latest, key))
      .filter((item) => item !== undefined)
  : [];

const crumbs = [{ name: 'Finances', href: '/finances' }];
const description = `Calatagan municipal income and spending as reported to DILG: ${verifiedFilings.length} quarterly statements, every figure traced to its cell in the original filing.`;

const origin = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Calatagan, Batangas — Statements of Receipts and Expenditures',
    description: `Line items from ${verifiedFilings.length} quarterly Statements of Receipts and Expenditures the Municipality of Calatagan filed with the DILG Full Disclosure Policy Portal, each traced to its worksheet cell and checked against the filing’s own totals. Reported figures, not audited.`,
    url: new URL('/finances', origin).toString(),
    isAccessibleForFree: true,
    creator: { '@type': 'GovernmentOrganization', name: 'Municipality of Calatagan, Batangas' },
    publisher: { '@type': 'Organization', name: SITE.name },
    ...(oldest && latest
      ? { temporalCoverage: `${oldest.documentPeriod.year}/${latest.documentPeriod.year}` }
      : {}),
    spatialCoverage: { '@type': 'Place', name: 'Calatagan, Batangas, Philippines' },
    isBasedOn: financialsSource.sources.map((s) => s.url),
    distribution: [
      {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: new URL('/data/financials.json', origin).toString(),
      },
    ],
  },
];
---

<Base title="Calatagan municipal finances" {description} {crumbs} {jsonLd}>
  <PageHeader
    eyebrow="Finances"
    title="What the municipality reports it receives and spends"
    lede="Every quarter the municipality files a Statement of Receipts and Expenditures with the Department of the Interior and Local Government. These are the figures from those filings — each traced to the cell it came from, and checked against the filing’s own totals."
    {crumbs}
  />

  <div class="container page-body">
    {latest && latestHeadline && (
      <section class="section" aria-labelledby="latest-title">
        <p class="eyebrow">Latest filing</p>
        <h2 id="latest-title">Year to date, {period}</h2>
        <p class="prose headline-text">
          Calatagan reported income of <strong>{formatPeso(latestHeadline.income ?? 0)}</strong> and
          operating expenditure of <strong>{formatPeso(latestHeadline.expenditures ?? 0)}</strong>.
          {externalShare !== null && (
            <>
              {' '}Of that income, <strong>{externalShare}%</strong> came from the national
              government rather than from local taxes and fees.
            </>
          )}
        </p>

        <dl class="stat-grid">
          <div>
            <dt>Total income</dt>
            <dd class="figure">{formatPesoMillions(latestHeadline.income ?? 0)}</dd>
            <dd class="exact">{pesoExact.format(latestHeadline.income ?? 0)}</dd>
          </div>
          <div>
            <dt>Raised locally</dt>
            <dd class="figure">{formatPesoMillions(latestHeadline.localSources ?? 0)}</dd>
            <dd class="exact">{pesoExact.format(latestHeadline.localSources ?? 0)}</dd>
          </div>
          <div>
            <dt>National Tax Allotment</dt>
            <dd class="figure">{formatPesoMillions(latestHeadline.nationalTaxAllotment ?? 0)}</dd>
            <dd class="exact">{pesoExact.format(latestHeadline.nationalTaxAllotment ?? 0)}</dd>
          </div>
          <div>
            <dt>Operating expenditure</dt>
            <dd class="figure">{formatPesoMillions(latestHeadline.expenditures ?? 0)}</dd>
            <dd class="exact">{pesoExact.format(latestHeadline.expenditures ?? 0)}</dd>
          </div>
          <div>
            <dt>Cash balance, end of period</dt>
            <dd class="figure">{formatPesoMillions(latestHeadline.cashBalanceEnd ?? 0)}</dd>
            <dd class="exact">{pesoExact.format(latestHeadline.cashBalanceEnd ?? 0)}</dd>
          </div>
        </dl>

        {composition && (
          <figure class="composition">
            <figcaption>Where {period} income came from</figcaption>
            <div class="stack-bar" aria-hidden="true">
              {composition.map((part) => (
                <span class={`seg seg-${part.key}`} style={`width:${part.share.toFixed(2)}%`}></span>
              ))}
            </div>
            <ul class="legend">
              {composition.map((part) => (
                <li>
                  <span class={`swatch seg-${part.key}`} aria-hidden="true"></span>
                  <span class="legend-label">{part.label}</span>
                  <span class="legend-value num">
                    {part.share > 0 && part.share < 0.5 ? '<1' : part.share.toFixed(0)}% · {formatPeso(part.value)}
                  </span>
                </li>
              ))}
            </ul>
          </figure>
        )}

        <p class="small muted">
          Figures are cumulative within the calendar year: a Q{latest.documentPeriod.quarter} figure
          already includes the earlier quarters of CY{latest.documentPeriod.year}.
          {latestRecord && (
            <>
              {' '}<a href={latestRecord.downloadUrl} rel="noopener noreferrer nofollow">
                Download the original filing from DILG<span aria-hidden="true"> ↗</span>
              </a>
            </>
          )}
        </p>

        <Source source={financialsSource} label="these figures" />
      </section>
    )}

    <section class="section" aria-labelledby="income-title">
      <p class="eyebrow">Income</p>
      <h2 id="income-title">Where the money comes from</h2>
      <p class="prose">
        Like most Philippine municipalities, Calatagan is funded mainly by its share of national
        taxes. The table shows the latest filing in full; every row names the worksheet cell it was
        read from.
      </p>
      <div class="table-wrap" role="region" aria-labelledby="income-caption" tabindex="0">
        <table class="line-items sticky-first">
          <caption id="income-caption">
            Income, {period}, in pesos
            <span class="scroll-hint">Scroll sideways to see every column.</span>
          </caption>
          <thead>
            <tr>
              <th scope="col">Line item</th>
              <th scope="col" class="num">General Fund</th>
              <th scope="col" class="num">SEF</th>
              <th scope="col" class="num">Total</th>
              <th scope="col">Cell</th>
            </tr>
          </thead>
          <tbody>
            {incomeRows.map((item) => (
              <tr class={`level-${item.level}`}>
                <th scope="row">{item.label}</th>
                <td class="num">{item.generalFund ? formatNumber(item.generalFund.value) : '—'}</td>
                <td class="num">{item.sef ? formatNumber(item.sef.value) : '—'}</td>
                <td class="num">{item.total ? formatNumber(item.total.value) : '—'}</td>
                <td><code>{item.total?.cell ?? '—'}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted prose">
        SEF is the Special Education Fund, a separate levy on real property that may only be spent
        on education. It is reported alongside the General Fund but is not interchangeable with it.
      </p>
    </section>

    <section class="section" aria-labelledby="spending-title">
      <p class="eyebrow">Spending</p>
      <h2 id="spending-title">Where it goes</h2>
      <p class="prose">Operating expenditure by sector, {period}, largest first.</p>
      <ol class="sectors">
        {sectors.map((sector) => (
          <li>
            <div class="sector-head">
              <span class="sector-label">{sector.label}</span>
              <span class="amount num">
                {formatPeso(sector.value)}
                {sectorTotal > 0 && (
                  <span class="share"> · {Math.round((sector.value / sectorTotal) * 100)}%</span>
                )}
              </span>
            </div>
            <div class="bar" aria-hidden="true">
              <span style={`width:${Math.max(0.5, (sector.value / sectorMax) * 100)}%`}></span>
            </div>
            <div class="cell-ref">Cell <code>{sector.cell ?? '—'}</code></div>
          </li>
        ))}
      </ol>
    </section>

    {years.length > 1 && (
      <section class="section" aria-labelledby="years-title">
        <p class="eyebrow">Trend</p>
        <h2 id="years-title">Full years</h2>
        <p class="prose">
          Fourth-quarter filings report the whole calendar year, so these rows are annual totals.
        </p>
        <div class="table-wrap" role="region" aria-labelledby="years-caption" tabindex="0">
          <table class="sticky-first">
            <caption id="years-caption">
              Annual totals from fourth-quarter filings, in pesos
              <span class="scroll-hint">Scroll sideways to see every column.</span>
            </caption>
            <thead>
              <tr>
                <th scope="col">Year</th>
                <th scope="col" class="num">Income</th>
                <th scope="col" class="num">Raised locally</th>
                <th scope="col" class="num">National Tax Allotment</th>
                <th scope="col" class="num">Operating expenditure</th>
                <th scope="col">Filing</th>
              </tr>
            </thead>
            <tbody>
              {years.map((row) => {
                const record = filingRecord(row.filing.filingId);
                return (
                  <tr>
                    <th scope="row">CY{row.year}</th>
                    <td class="num">{formatNumber(row.income ?? 0)}</td>
                    <td class="num">{formatNumber(row.localSources ?? 0)}</td>
                    <td class="num">{formatNumber(row.nationalTaxAllotment ?? 0)}</td>
                    <td class="num">{formatNumber(row.expenditures ?? 0)}</td>
                    <td>
                      {record ? (
                        <a href={record.downloadUrl} rel="noopener noreferrer nofollow">
                          DILG<span class="visually-hidden"> filing for CY{row.year}</span>
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      ) : (
                        '—'
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="quarters-title">
      <p class="eyebrow">Every filing</p>
      <h2 id="quarters-title">Every quarter on file</h2>
      <div class="table-wrap" role="region" aria-labelledby="quarters-caption" tabindex="0">
        <table class="sticky-first">
          <caption id="quarters-caption">
            {verifiedFilings.length} verified quarterly statements, cumulative year to date, in pesos
            <span class="scroll-hint">Scroll sideways to see every column.</span>
          </caption>
          <thead>
            <tr>
              <th scope="col">Period</th>
              <th scope="col" class="num">Income</th>
              <th scope="col" class="num">Operating expenditure</th>
              <th scope="col" class="num">Checks passed</th>
              <th scope="col">Original</th>
            </tr>
          </thead>
          <tbody>
            {verifiedFilings.map((filing) => {
              const figures = headline(filing);
              const record = filingRecord(filing.filingId);
              const label = `Q${filing.documentPeriod.quarter} CY${filing.documentPeriod.year}`;
              return (
                <tr>
                  <th scope="row">{label}</th>
                  <td class="num">{formatNumber(figures.income ?? 0)}</td>
                  <td class="num">{formatNumber(figures.expenditures ?? 0)}</td>
                  <td class="num">
                    {filing.reconciliation.passed}/{filing.reconciliation.total}
                  </td>
                  <td>
                    {record ? (
                      <a href={record.downloadUrl} rel="noopener noreferrer nofollow">
                        DILG<span class="visually-hidden"> filing for {label}</span>
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    ) : (
                      '—'
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section prose" aria-labelledby="method-title">
      <p class="eyebrow">Method</p>
      <h2 id="method-title">How these figures were checked</h2>
      <p>
        Each filing asserts a number of things about itself: that the General Fund and Special
        Education Fund columns add to the total column, that tax and non-tax revenue add to local
        sources, that the sectoral spending lines add to total expenditure, and so on. Every one of
        those identities is recomputed from the extracted values.
      </p>
      <p>
        Across <strong>{verifiedFilings.length}</strong> quarters,
        <strong> {formatNumber(totalChecks)}</strong> checks were recomputed and
        <strong> all passed</strong>. A filing whose own arithmetic did not hold would be excluded
        from this page rather than shown with a warning.
        {sreDataset.extractedCount > verifiedFilings.length && (
          <>
            {' '}{sreDataset.extractedCount - verifiedFilings.length} of{' '}
            {sreDataset.extractedCount} extracted filings are currently held back on that basis.
          </>
        )}
      </p>
      <div class="callout">
        <p>
          <strong>An SRE is not an audit.</strong> These are the municipality’s own reported figures,
          filed with DILG. The Commission on Audit publishes separate audited statements which this
          project has not yet been able to obtain — see <a href="/sources#withheld">Sources</a>.
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .page-body {
    padding-block: var(--sp-6) var(--sp-8);
  }
  .headline-text {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    line-height: 1.55;
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--sp-3);
    margin: var(--sp-5) 0;
  }
  .stat-grid > div {
    padding: var(--sp-4);
    background: var(--c-surface);
    border: var(--border);
    border-top: 3px solid var(--c-navy);
    border-radius: var(--radius-md);
  }
  .stat-grid dt {
    min-height: 2.6em;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .stat-grid dd {
    margin: 0;
  }
  .stat-grid .figure {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--c-navy);
    margin-top: var(--sp-1);
  }
  .exact {
    font-size: var(--fs-xs);
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }

  .composition {
    margin: var(--sp-5) 0;
    max-width: 48rem;
  }
  .composition figcaption {
    font-weight: 650;
    margin-bottom: var(--sp-2);
  }
  .stack-bar {
    display: flex;
    height: 14px;
    border-radius: 3px;
    overflow: hidden;
    background: var(--c-sunk);
  }
  .stack-bar .seg + .seg {
    border-left: 2px solid var(--c-bg);
  }
  .seg-nta {
    background: var(--c-navy);
  }
  .seg-other-ext {
    background: var(--c-accent);
  }
  .seg-local {
    background: var(--c-clay);
  }
  .legend {
    list-style: none;
    padding: 0;
    margin: var(--sp-3) 0 0;
    display: grid;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
  }
  .legend li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--sp-2);
    margin: 0;
  }
  .legend-value {
    grid-column: 2;
    color: var(--c-ink-2);
  }
  @media (min-width: 40rem) {
    .legend li {
      grid-template-columns: auto 1fr auto;
    }
    .legend-value {
      grid-column: 3;
    }
  }
  .swatch {
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.3em;
    border-radius: 2px;
  }

  .line-items tr.level-0 th,
  .line-items tr.level-0 td {
    font-weight: 700;
  }
  .line-items tr.level-1 th {
    font-weight: 650;
  }
  .line-items tr.level-2 th {
    padding-left: var(--sp-5);
    font-weight: 500;
  }
  .line-items tr.level-3 th {
    padding-left: var(--sp-7);
    font-weight: 400;
    color: var(--c-ink-2);
  }

  .sectors {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0 0;
    max-width: 48rem;
  }
  .sectors li {
    margin: 0 0 var(--sp-4);
  }
  .sector-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-1) var(--sp-3);
    margin-bottom: var(--sp-1);
    font-size: var(--fs-sm);
  }
  .sector-label {
    font-weight: 600;
  }
  .amount {
    white-space: nowrap;
  }
  .share {
    color: var(--c-muted);
  }
  .bar {
    height: 8px;
    background: var(--c-sunk);
    border-radius: 2px;
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--c-accent);
  }
  .cell-ref {
    margin-top: 2px;
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
</style>
