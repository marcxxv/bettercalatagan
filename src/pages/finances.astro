---
import { fdpReadAttrs } from '../lib/viewer';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Source from '../components/Source.astro';
import Icon from '../components/Icon.astro';
import Donut from '../components/Donut.astro';
import ColumnChart from '../components/ColumnChart.astro';
import LineChart from '../components/LineChart.astro';
import {
  annualSeries,
  filingRecord,
  financialsSource,
  headline,
  itemOf,
  latestFiling,
  sectorSpending,
  sreDataset,
  verifiedFilings,
} from '../data/financials';
import type { SreFiling } from '../data/schemas/sre';
import { formatNumber, formatPeso, formatPesoMillions } from '../lib/format';
import { SITE } from '../lib/site';

const pesoExact = new Intl.NumberFormat('en-PH', {
  style: 'currency',
  currency: 'PHP',
  minimumFractionDigits: 2,
});

const latest = latestFiling;
const latestHeadline = latest ? headline(latest) : null;
const periodOf = (f: SreFiling) => `Q${f.documentPeriod.quarter} CY${f.documentPeriod.year}`;
const period = latest ? periodOf(latest) : '';
const years = annualSeries();
const totalChecks = verifiedFilings.reduce((sum, f) => sum + f.reconciliation.total, 0);
const oldest = verifiedFilings[verifiedFilings.length - 1];

/**
 * Income composition, drawn only when the parts add exactly to the reported
 * total — a chart must never imply a split the filing does not state.
 */
function composition(filing: SreFiling) {
  const { income, localSources, externalSources, nationalTaxAllotment } = headline(filing);
  if (income === null || localSources === null || externalSources === null || nationalTaxAllotment === null)
    return null;
  if (localSources + externalSources !== income || nationalTaxAllotment > externalSources) return null;
  return [
    { key: 'nta', label: 'National Tax Allotment', value: nationalTaxAllotment, color: 'var(--c-s1)' },
    {
      key: 'other-ext',
      label: 'Other national and external sources',
      value: externalSources - nationalTaxAllotment,
      color: 'var(--c-s5)',
    },
    { key: 'local', label: 'Raised locally (taxes, fees, receipts)', value: localSources, color: 'var(--c-s3)' },
  ]
    .filter((p) => p.value > 0)
    .map((p) => ({ ...p, share: (p.value / income) * 100 }));
}

/** Everything one period's panel shows. */
const panels = verifiedFilings.map((filing) => {
  const h = headline(filing);
  const sectors = sectorSpending(filing);
  const sectorTotal = sectors.reduce((sum, s) => sum + s.value, 0);
  return {
    id: filing.filingId,
    label: periodOf(filing),
    quarter: filing.documentPeriod.quarter,
    year: filing.documentPeriod.year,
    h,
    parts: composition(filing),
    sectors,
    sectorTotal,
    sectorMax: Math.max(1, ...sectors.map((s) => s.value)),
    externalShare: h.income && h.externalSources !== null ? Math.round((h.externalSources / h.income) * 100) : null,
    record: filingRecord(filing.filingId),
  };
});

/** Income composition of the latest filing, in the Total column. */
const incomeRows = latest
  ? [
      'local-sources',
      'tax-revenue',
      'real-property-tax',
      'tax-on-business',
      'other-taxes',
      'non-tax-revenue',
      'regulatory-fees',
      'service-user-charges',
      'economic-enterprises',
      'other-receipts',
      'external-sources',
      'national-tax-allotment',
      'other-national-shares',
      'inter-local-transfers',
      'extraordinary-receipts',
      'total-current-operating-income',
    ]
      .map((key) => itemOf(latest, key))
      .filter((item) => item !== undefined)
  : [];

// Year-to-date income by quarter, one line per calendar year.
const calendarYears = [...new Set(verifiedFilings.map((f) => f.documentPeriod.year))].sort();
const yearColors = ['var(--c-s5)', 'var(--c-s4)', 'var(--c-s2)', 'var(--c-s1)', 'var(--c-s3)'];
const ytdSeries = calendarYears.map((year, i) => ({
  name: `CY${year}`,
  color: yearColors[(yearColors.length - calendarYears.length + i + yearColors.length) % yearColors.length],
  values: [1, 2, 3, 4].map((q) => {
    const f = verifiedFilings.find((x) => x.documentPeriod.year === year && x.documentPeriod.quarter === q);
    return f ? headline(f).income : null;
  }),
}));

const localShare = years.map((y) =>
  y.income && y.localSources !== null ? Math.round((y.localSources / y.income) * 1000) / 10 : null,
);

const crumbs = [{ name: 'Finances', href: '/finances' }];
const description = `Calatagan municipal income and spending as reported to DILG: ${verifiedFilings.length} quarterly statements, every figure traced to its cell in the original filing.`;

const origin = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Calatagan, Batangas — Statements of Receipts and Expenditures',
    description: `Line items from ${verifiedFilings.length} quarterly Statements of Receipts and Expenditures the Municipality of Calatagan filed with the DILG Full Disclosure Policy Portal, each traced to its worksheet cell and checked against the filing’s own totals. Reported figures, not audited.`,
    url: new URL('/finances', origin).toString(),
    isAccessibleForFree: true,
    creator: { '@type': 'GovernmentOrganization', name: 'Municipality of Calatagan, Batangas' },
    publisher: { '@type': 'Organization', name: SITE.name },
    ...(oldest && latest
      ? { temporalCoverage: `${oldest.documentPeriod.year}/${latest.documentPeriod.year}` }
      : {}),
    spatialCoverage: { '@type': 'Place', name: 'Calatagan, Batangas, Philippines' },
    isBasedOn: financialsSource.sources.map((s) => s.url),
    distribution: [
      {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: new URL('/data/financials.json', origin).toString(),
      },
    ],
  },
];
---

<Base title="Calatagan municipal finances" {description} {crumbs} {jsonLd}>
  <PageHeader
    eyebrow="Finances"
    icon="coins"
    title="What the municipality reports it receives and spends"
    lede="Every quarter the municipality files a Statement of Receipts and Expenditures with the Department of the Interior and Local Government. These are the figures from those filings — each traced to the cell it came from, and checked against the filing’s own totals."
    {crumbs}
  >
    <Fragment slot="meta">
      <span class="chip ok"><Icon name="check" size="14" /> {formatNumber(totalChecks)} checks passed</span>
      <span class="chip navy">{verifiedFilings.length} quarters on file</span>
      <span class="chip">Reported, not audited</span>
    </Fragment>
    {latestHeadline && (
      <dl slot="aside" class="hero-figs">
        <div>
          <dt>Income, {period} YTD</dt>
          <dd class="figure">{formatPesoMillions(latestHeadline.income ?? 0)}</dd>
        </div>
        <div>
          <dt>Operating expenditure</dt>
          <dd class="figure">{formatPesoMillions(latestHeadline.expenditures ?? 0)}</dd>
        </div>
        <div>
          <dt>Cash balance, end of period</dt>
          <dd class="figure">{formatPesoMillions(latestHeadline.cashBalanceEnd ?? 0)}</dd>
        </div>
      </dl>
    )}
  </PageHeader>

  <div class="container wide with-rail page-body">
    <aside class="rail">
      <nav class="rail-nav" aria-labelledby="fin-toc" data-spy>
        <p class="rail-title" id="fin-toc">On this page</p>
        <ul>
          <li><a href="#snapshot">Snapshot by period</a></li>
          <li><a href="#trend">Trend</a></li>
          <li><a href="#income">Income line items</a></li>
          <li><a href="#quarters">Every quarter</a></li>
          <li><a href="#method">Method</a></li>
        </ul>
      </nav>
    </aside>

    <div class="content">
      {panels.length > 0 && (
        <section class="block" id="snapshot" aria-labelledby="snapshot-title">
          <div class="snap-head">
            <div>
              <p class="eyebrow">Snapshot</p>
              <h2 id="snapshot-title">Year to date, by period</h2>
            </div>
            <p class="field period-picker js-flex">
              <label for="period">Filing period</label>
              <select id="period" data-period-select>
                {panels.map((p, i) => (
                  <option value={p.id} selected={i === 0}>
                    {p.label}{p.quarter === 4 ? ' · full year' : ' · year to date'}
                  </option>
                ))}
              </select>
            </p>
          </div>

          {panels.map((p, i) => (
            <div class="panel" data-period={p.id} data-ask-label={`Statement for ${p.label}`} hidden={i !== 0}>
              <p class="headline-text">
                For {p.label}, Calatagan reported income of <strong>{formatPeso(p.h.income ?? 0)}</strong>{' '}
                and operating expenditure of <strong>{formatPeso(p.h.expenditures ?? 0)}</strong>.
                {p.externalShare !== null && (
                  <>
                    {' '}Of that income, <strong>{p.externalShare}%</strong> came from the national
                    government rather than from local taxes and fees.
                  </>
                )}
              </p>

              <dl class="stat-row">
                <div class="stat">
                  <dt>Total income</dt>
                  <dd class="figure">{formatPesoMillions(p.h.income ?? 0)}</dd>
                  <dd class="stat-note">{pesoExact.format(p.h.income ?? 0)}</dd>
                </div>
                <div class="stat">
                  <dt>Raised locally</dt>
                  <dd class="figure">{formatPesoMillions(p.h.localSources ?? 0)}</dd>
                  <dd class="stat-note">{pesoExact.format(p.h.localSources ?? 0)}</dd>
                </div>
                <div class="stat">
                  <dt>National Tax Allotment</dt>
                  <dd class="figure">{formatPesoMillions(p.h.nationalTaxAllotment ?? 0)}</dd>
                  <dd class="stat-note">{pesoExact.format(p.h.nationalTaxAllotment ?? 0)}</dd>
                </div>
                <div class="stat">
                  <dt>Operating expenditure</dt>
                  <dd class="figure">{formatPesoMillions(p.h.expenditures ?? 0)}</dd>
                  <dd class="stat-note">{pesoExact.format(p.h.expenditures ?? 0)}</dd>
                </div>
              </dl>

              <div class="viz-grid">
                {p.parts && (
                  <figure class="card viz composition">
                    <figcaption>Where {p.label} income came from</figcaption>
                    <div class="comp-body">
                      <Donut
                        parts={p.parts}
                        centerLabel="Total income"
                        centerValue={formatPesoMillions(p.h.income ?? 0)}
                        size={200}
                      />
                      <ul class="comp-legend">
                        {p.parts.map((part) => (
                          <li>
                            <span class="swatch" style={`background:${part.color}`}></span>
                            <span class="cl-label">{part.label}</span>
                            <span class="cl-share figure">
                              {part.share > 0 && part.share < 0.5 ? '<1' : part.share.toFixed(0)}%
                            </span>
                            <span class="cl-value num">{formatPeso(part.value)}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </figure>
                )}

                <figure class="card viz" id={i === 0 ? 'spending' : undefined}>
                  <figcaption>Operating expenditure by sector, largest first</figcaption>
                  <ol class="sectors" data-animate>
                    {p.sectors.map((sector, si) => (
                      <li>
                        <div class="sector-head">
                          <span class="sector-label">{sector.label}</span>
                          <span class="amount num">
                            {sector.value >= 100_000 ? formatPesoMillions(sector.value) : formatPeso(sector.value)}
                            {p.sectorTotal > 0 && (
                              <span class="share"> · {Math.round((sector.value / p.sectorTotal) * 100)}%</span>
                            )}
                          </span>
                        </div>
                        <div class="bar" aria-hidden="true">
                          <span
                            data-grow
                            style={`width:${Math.max(0.5, (sector.value / p.sectorMax) * 100)}%;--reveal-delay:${si * 70}ms`}
                            data-tip={`${sector.label}|${formatPeso(sector.value)}|Cell ${sector.cell ?? '—'}`}
                          ></span>
                        </div>
                        <div class="cell-ref">Cell <code>{sector.cell ?? '—'}</code></div>
                      </li>
                    ))}
                  </ol>
                </figure>
              </div>

              <p class="small muted">
                Figures are cumulative within the calendar year: a Q{p.quarter} figure already
                includes the earlier quarters of CY{p.year}.
                {p.record && (
                  <>
                    {' '}<a href={p.record.downloadUrl} rel="noopener noreferrer nofollow" {...fdpReadAttrs(p.record, p.label)}>
                      Read the original {p.label} filing from DILG
                    </a>
                  </>
                )}
              </p>
            </div>
          ))}

          <Source source={financialsSource} label="these figures" />
        </section>
      )}

      {years.length > 1 && (
        <section class="block" id="trend" aria-labelledby="years-title">
          <p class="eyebrow">Trend</p>
          <h2 id="years-title">Full years and the year so far</h2>
          <p class="prose">
            Fourth-quarter filings report the whole calendar year, so the first chart compares annual
            totals. The second follows income through each year, quarter by quarter.
          </p>
          <div class="viz-grid">
            <div class="card viz">
              <ColumnChart
                caption="Full-year income and operating expenditure"
                categories={years.map((y) => `CY${y.year}`)}
                series={[
                  { name: 'Income', color: 'var(--c-s1)', values: years.map((y) => y.income) },
                  { name: 'Operating expenditure', color: 'var(--c-s2)', values: years.map((y) => y.expenditures) },
                  { name: 'Raised locally', color: 'var(--c-s3)', values: years.map((y) => y.localSources) },
                ]}
                format="peso-m"
                notes={localShare.map((s) => (s === null ? '' : `Raised locally: ${s}% of income`))}
              />
            </div>
            <div class="card viz">
              <LineChart
                caption="Income, year to date, by quarter"
                categories={['Q1', 'Q2', 'Q3', 'Q4']}
                series={ytdSeries}
                format="peso-m"
              />
            </div>
          </div>

          <details class="data-table">
            <summary>View annual totals as a table</summary>
            <div class="table-wrap" role="region" aria-labelledby="years-caption" tabindex="0">
              <table class="sticky-first">
                <caption id="years-caption">
                  Annual totals from fourth-quarter filings, in pesos
                  <span class="scroll-hint">Scroll sideways to see every column.</span>
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Year</th>
                    <th scope="col" class="num">Income</th>
                    <th scope="col" class="num">Raised locally</th>
                    <th scope="col" class="num">National Tax Allotment</th>
                    <th scope="col" class="num">Operating expenditure</th>
                    <th scope="col">Filing</th>
                  </tr>
                </thead>
                <tbody>
                  {years.map((row) => {
                    const record = filingRecord(row.filing.filingId);
                    return (
                      <tr>
                        <th scope="row">CY{row.year}</th>
                        <td class="num">{formatNumber(row.income ?? 0)}</td>
                        <td class="num">{formatNumber(row.localSources ?? 0)}</td>
                        <td class="num">{formatNumber(row.nationalTaxAllotment ?? 0)}</td>
                        <td class="num">{formatNumber(row.expenditures ?? 0)}</td>
                        <td>
                          {record ? (
                            <a href={record.downloadUrl} rel="noopener noreferrer nofollow" {...fdpReadAttrs(record, `CY${row.year}`)}>
                              Read<span class="visually-hidden"> the DILG filing for CY{row.year}</span>
                            </a>
                          ) : (
                            '—'
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </details>
        </section>
      )}

      <section class="block" id="income" aria-labelledby="income-title">
        <p class="eyebrow">Income</p>
        <h2 id="income-title">Where the money comes from</h2>
        <p class="prose">
          Like most Philippine municipalities, Calatagan is funded mainly by its share of national
          taxes. The table shows the latest filing ({period}) in full; every row names the worksheet
          cell it was read from.
        </p>
        <div class="table-wrap" role="region" aria-labelledby="income-caption" tabindex="0">
          <table class="line-items sticky-first">
            <caption id="income-caption">
              Income, {period}, in pesos
              <span class="scroll-hint">Scroll sideways to see every column.</span>
            </caption>
            <thead>
              <tr>
                <th scope="col">Line item</th>
                <th scope="col" class="num">General Fund</th>
                <th scope="col" class="num">SEF</th>
                <th scope="col" class="num">Total</th>
                <th scope="col">Cell</th>
              </tr>
            </thead>
            <tbody>
              {incomeRows.map((item) => (
                <tr class={`level-${item.level}`}>
                  <th scope="row">{item.label}</th>
                  <td class="num">{item.generalFund ? formatNumber(item.generalFund.value) : '—'}</td>
                  <td class="num">{item.sef ? formatNumber(item.sef.value) : '—'}</td>
                  <td class="num">{item.total ? formatNumber(item.total.value) : '—'}</td>
                  <td><code>{item.total?.cell ?? '—'}</code></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small muted prose">
          SEF is the Special Education Fund, a separate levy on real property that may only be spent
          on education. It is reported alongside the General Fund but is not interchangeable with it.
        </p>
      </section>

      <section class="block" id="quarters" aria-labelledby="quarters-title">
        <p class="eyebrow">Every filing</p>
        <h2 id="quarters-title">Every quarter on file</h2>
        <div class="table-wrap" role="region" aria-labelledby="quarters-caption" tabindex="0">
          <table class="sticky-first">
            <caption id="quarters-caption">
              {verifiedFilings.length} verified quarterly statements, cumulative year to date, in pesos
              <span class="scroll-hint">Scroll sideways to see every column.</span>
            </caption>
            <thead>
              <tr>
                <th scope="col">Period</th>
                <th scope="col" class="num">Income</th>
                <th scope="col" class="num">Operating expenditure</th>
                <th scope="col" class="num">Checks passed</th>
                <th scope="col">Original</th>
              </tr>
            </thead>
            <tbody>
              {verifiedFilings.map((filing) => {
                const figures = headline(filing);
                const record = filingRecord(filing.filingId);
                const label = periodOf(filing);
                return (
                  <tr>
                    <th scope="row">{label}</th>
                    <td class="num">{formatNumber(figures.income ?? 0)}</td>
                    <td class="num">{formatNumber(figures.expenditures ?? 0)}</td>
                    <td class="num">
                      <span class="pass"><Icon name="check" size="14" /> {filing.reconciliation.passed}/{filing.reconciliation.total}</span>
                    </td>
                    <td>
                      {record ? (
                        <a href={record.downloadUrl} rel="noopener noreferrer nofollow" {...fdpReadAttrs(record, label)}>
                          Read<span class="visually-hidden"> the DILG filing for {label}</span>
                        </a>
                      ) : (
                        '—'
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <section class="block prose" id="method" aria-labelledby="method-title">
        <p class="eyebrow">Method</p>
        <h2 id="method-title">How these figures were checked</h2>
        <p>
          Each filing asserts a number of things about itself: that the General Fund and Special
          Education Fund columns add to the total column, that tax and non-tax revenue add to local
          sources, that the sectoral spending lines add to total expenditure, and so on. Every one of
          those identities is recomputed from the extracted values.
        </p>
        <p>
          Across <strong>{verifiedFilings.length}</strong> quarters,
          <strong> {formatNumber(totalChecks)}</strong> checks were recomputed and
          <strong> all passed</strong>. A filing whose own arithmetic did not hold would be excluded
          from this page rather than shown with a warning.
          {sreDataset.extractedCount > verifiedFilings.length && (
            <>
              {' '}{sreDataset.extractedCount - verifiedFilings.length} of{' '}
              {sreDataset.extractedCount} extracted filings are currently held back on that basis.
            </>
          )}
        </p>
        <div class="callout warn">
          <p class="callout-title"><Icon name="alert" size="18" /> An SRE is not an audit</p>
          <p>
            These are the municipality’s own reported figures, filed with DILG. The Commission on
            Audit publishes separate audited statements which this project has not yet been able to
            obtain — see <a href="/sources#withheld">Sources</a>.
          </p>
        </div>
      </section>
    </div>
  </div>

  <script>
    // Period switcher: show one pre-rendered panel at a time.
    const select = document.querySelector<HTMLSelectElement>('[data-period-select]');
    const panels = [...document.querySelectorAll<HTMLElement>('[data-period]')];
    if (select && panels.length) {
      const show = (id: string) => {
        for (const panel of panels) {
          const on = panel.dataset.period === id;
          panel.hidden = !on;
          if (on) {
            for (const el of panel.querySelectorAll('[data-animate], [data-grow]')) {
              el.classList.remove('is-in');
              requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-in')));
            }
          }
        }
      };
      select.addEventListener('change', () => show(select.value));
    }
  </script>
</Base>

<style>
  .hero-figs {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
  }
  .hero-figs > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(6px);
  }
  .hero-figs dt {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-band-muted);
  }
  .hero-figs dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--c-band-ink);
  }
  .page-body {
    padding-block: var(--sp-7) var(--sp-9);
  }
  .block + .block {
    margin-top: var(--sp-9);
    padding-top: var(--sp-7);
    border-top: 1px solid var(--c-line);
  }
  .block > h2 {
    margin-top: 0;
  }
  .snap-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }
  .snap-head h2 {
    margin: 0;
  }
  .period-picker {
    display: none;
    min-width: 16rem;
  }
  :global(.js) .period-picker {
    display: flex;
  }
  .panel[hidden] {
    display: none;
  }
  .headline-text {
    max-width: 64ch;
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    line-height: 1.6;
  }
  .stat-row {
    margin-block: var(--sp-5);
  }
  .stat .figure {
    font-size: var(--fs-xl);
  }
  .viz-grid {
    display: grid;
    gap: var(--sp-4);
    margin-block: var(--sp-5);
  }
  @media (min-width: 80rem) {
    .viz-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .viz {
    margin: 0;
    padding: var(--sp-5);
  }
  .viz > figcaption,
  .viz :global(figcaption) {
    font-weight: 700;
    margin-bottom: var(--sp-4);
  }
  .comp-body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
  }
  .comp-legend {
    flex: 1 1 14rem;
    list-style: none;
