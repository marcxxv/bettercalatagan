---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Source from '../components/Source.astro';
import { hotlines, hotlinesSource, localHotlines, localHotlinesSource } from '../data/calendar';

/**
 * Hotlines, held to the site's standard: only numbers fixed by law are
 * listed. Local numbers are withheld (see municipality.ts, WITHHELD) because
 * the only records of them are years out of date, and a wrong emergency
 * number is worse than none.
 */

const crumbs = [
  { name: 'Services', href: '/services' },
  { name: 'Hotlines', href: '/hotlines' },
];
const description = 'Emergency and complaint hotlines for Calatagan, Batangas: the national numbers set by executive order, and why local numbers are not listed.';
---

<Base title="Emergency hotlines" {description} {crumbs}>
  <PageHeader
    eyebrow="Services"
    icon="alert"
    title="Emergency hotlines"
    lede="In an emergency, call 911: the Philippines’ nationwide emergency number, set by executive order, free from any phone. Calatagan’s own emergency lines are listed below."
    {crumbs}
  />

  <div class="container wide page-body">
    <ul class="lines">
      {hotlines.map((line) => (
        <li class:list={['line', { primary: line.number === '911' }]}>
          <a class="number" href={`tel:${line.number}`}>
            <span class="visually-hidden">Call </span>{line.number}
          </a>
          <div>
            <h2>{line.name}</h2>
            <p>{line.what}</p>
            <p class="small muted">Set by <a href={line.source.url} rel="noopener nofollow">{line.source.name.split(' — ')[0]}</a></p>
          </div>
        </li>
      ))}
    </ul>

    <Source source={hotlinesSource} label="these numbers" />

    <section class="section-block" id="local" aria-labelledby="local-title">
      <p class="eyebrow">In Calatagan</p>
      <h2 id="local-title">Local emergency hotlines</h2>
      <p class="lede">The municipality’s own list of emergency numbers. Tap a number to call it.</p>
      <ul class="local">
        {localHotlines.map((line) => (
          <li class:list={['local-line', { lead: line.office === 'MDRRMO' }]}>
            <p class="local-office">{line.office}</p>
            <p class="local-what">{line.what}</p>
            <p class="local-numbers">
              {line.numbers.map((n) => <a href={`tel:${n.replace(/[^\d+]/g, '')}`}>{n}</a>)}
            </p>
          </li>
        ))}
      </ul>
      <Source source={localHotlinesSource} label="the local numbers" />
    </section>
  </div>
</Base>

<style>
  .local {
    list-style: none;
    margin: var(--sp-4) 0 var(--sp-5);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: var(--sp-3);
  }
  .local > li + li {
    margin: 0;
  }
  .local-line {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: var(--sp-4) var(--sp-5);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
  }
  .local-line.lead {
    border-color: var(--c-accent-line);
    background: var(--c-accent-wash);
  }
  .local-office {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    color: var(--c-navy);
  }
  .local-what {
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .local-numbers {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .local-numbers a {
    font-size: var(--fs-md);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--c-ink);
    text-decoration: none;
  }
  .local-numbers a:hover {
    color: var(--c-accent);
    text-decoration: underline;
  }
  .lines {
    list-style: none;
    margin: 0 0 var(--sp-6);
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .lines > li + li {
    margin: 0;
  }
  .line {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-5);
    align-items: center;
    padding: var(--sp-5) var(--sp-6);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
  }
  .line.primary {
    border-color: var(--c-danger);
  }
  .number {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--c-ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .line.primary .number {
    color: var(--c-danger);
  }
  .line h2 {
    margin: 0 0 var(--sp-1);
    font-size: var(--fs-md);
  }
  .line p {
    margin: 0 0 var(--sp-1);
  }
  @media (max-width: 30rem) {
    .line {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
  }
</style>
