---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Source from '../components/Source.astro';
import Icon from '../components/Icon.astro';
import { hotlines, hotlinesSource } from '../data/calendar';
import { offices } from '../data/services';

/**
 * Hotlines, held to the site's standard: only numbers fixed by law are
 * listed. Local numbers are withheld (see municipality.ts, WITHHELD) because
 * the only records of them are years out of date, and a wrong emergency
 * number is worse than none.
 */

const crumbs = [
  { name: 'Services', href: '/services' },
  { name: 'Hotlines', href: '/hotlines' },
];
const mdrrmo = offices.find((office) => office.slug === 'disaster')!;
const description = 'Emergency and complaint hotlines for Calatagan, Batangas: the national numbers set by executive order, and why local numbers are not listed.';
---

<Base title="Emergency hotlines" {description} {crumbs}>
  <PageHeader
    eyebrow="Services"
    icon="alert"
    title="Emergency hotlines"
    lede="In an emergency, call 911. It is the Philippines’ nationwide emergency number, set by executive order, and it works from any phone."
    {crumbs}
  />

  <div class="container wide page-body">
    <ul class="lines">
      {hotlines.map((line) => (
        <li class:list={['line', { primary: line.number === '911' }]}>
          <a class="number" href={`tel:${line.number}`}>
            <span class="visually-hidden">Call </span>{line.number}
          </a>
          <div>
            <h2>{line.name}</h2>
            <p>{line.what}</p>
            <p class="small muted">Set by <a href={line.source.url} rel="noopener nofollow">{line.source.name.split(' — ')[0]}</a></p>
          </div>
        </li>
      ))}
    </ul>

    <div class="callout clay">
      <p class="callout-title"><Icon name="alert" size="18" /> Why local numbers are not listed</p>
      <p>
        Numbers for the municipal hall, the {mdrrmo.short}, the police and the fire station circulate
        online, but the only records this project can find are years out of date and cannot be
        confirmed. A wrong emergency number costs time when time matters most, so none is published
        until a current primary source is found. The {mdrrmo.name} listed emergency response and an
        ambulance as round-the-clock services in its 2022 charter (<a href="/services#disaster">see
        services</a>). <a href="/sources#withheld">What else is withheld, and why</a>.
      </p>
    </div>

    <Source source={hotlinesSource} label="these numbers" />
  </div>
</Base>

<style>
  .lines {
    list-style: none;
    margin: 0 0 var(--sp-6);
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .lines > li + li {
    margin: 0;
  }
  .line {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-5);
    align-items: center;
    padding: var(--sp-5) var(--sp-6);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
  }
  .line.primary {
    border-color: var(--c-danger);
  }
  .number {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--c-ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .line.primary .number {
    color: var(--c-danger);
  }
  .line h2 {
    margin: 0 0 var(--sp-1);
    font-size: var(--fs-md);
  }
  .line p {
    margin: 0 0 var(--sp-1);
  }
  @media (max-width: 30rem) {
    .line {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
  }
</style>
