---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Source from '../components/Source.astro';
import { fdpDataset, fdpSource, fdpSummary, formatBytes } from '../data/fdp';
import { formatPeriod } from '../data/schemas/fdp';
import { formatDate, formatNumber } from '../lib/format';
import { SITE } from '../lib/site';

const records = fdpDataset.records;

const AVAILABILITY_LABEL: Record<string, string> = {
  available: 'Downloadable',
  'source-error': 'Unavailable at source',
  'missing-from-source': 'No longer listed',
  'not-checked': 'Not checked',
};

const rows = records.map((record) => ({
  ...record,
  periodLabel: formatPeriod(record.documentPeriod),
  postingLabel: record.postingPeriod ? formatPeriod(record.postingPeriod) : null,
  sizeLabel: formatBytes(record.byteLength),
  search: [record.formLabel, formatPeriod(record.documentPeriod), record.id].join(' ').toLowerCase(),
}));

const firstYear = Math.min(...fdpSummary.years);
const lastYear = Math.max(...fdpSummary.years);
const crumbs = [{ name: 'Disclosures', href: '/transparency' }];
const description = `All ${fdpSummary.total} Full Disclosure Policy filings the Municipality of Calatagan posted to the DILG portal, CY${firstYear}–CY${lastYear}, each linked to the original document.`;

const origin = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Calatagan, Batangas — Full Disclosure Policy filings index',
    description: `An index of ${fdpSummary.total} documents the Municipality of Calatagan posted to the DILG Full Disclosure Policy Portal, with document and posting periods, availability, and content fingerprints.`,
    url: new URL('/transparency', origin).toString(),
    isAccessibleForFree: true,
    creator: { '@type': 'Organization', name: SITE.name },
    temporalCoverage: `${firstYear}/${lastYear}`,
    spatialCoverage: { '@type': 'Place', name: 'Calatagan, Batangas, Philippines' },
    isBasedOn: fdpSource.sources.map((s) => s.url),
    distribution: [
      {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: new URL('/data/fdp-filings.json', origin).toString(),
      },
    ],
  },
];
---

<Base title="Calatagan Full Disclosure Policy filings" {description} {crumbs} {jsonLd}>
  <PageHeader
    eyebrow="Disclosures"
    title="Full Disclosure Policy filings"
    lede="Philippine local governments must publish certain financial and procurement documents under the DILG’s Full Disclosure Policy. This is an index of every such filing the Municipality of Calatagan has posted, each linked to the original on the DILG portal."
    {crumbs}
  />

  <div class="container page-body">
    <dl class="summary">
      <div>
        <dt>Filings indexed</dt>
        <dd class="figure">{formatNumber(fdpSummary.total)}</dd>
      </div>
      <div>
        <dt>Form types</dt>
        <dd class="figure">{fdpSummary.forms.length}<span class="of"> of 14</span></dd>
      </div>
      <div>
        <dt>Periods covered</dt>
        <dd class="figure">{firstYear}–{lastYear}</dd>
      </div>
      <div>
        <dt>Downloadable now</dt>
        <dd class="figure">
          {formatNumber(fdpSummary.available)}<span class="of"> of {formatNumber(fdpSummary.total)}</span>
        </dd>
      </div>
    </dl>

    <div class="callout">
      <p>
        <strong>This page indexes documents, not figures.</strong> No amount here has been extracted
        or restated — each entry sends you to the DILG original to read for yourself. For figures
        drawn from the quarterly statements, see <a href="/finances">Finances</a>.
      </p>
    </div>

    {fdpSummary.sourceError > 0 && (
      <div class="callout warn">
        <p>
          {formatNumber(fdpSummary.sourceError)} documents cannot be downloaded because the DILG
          portal returns a server error for them. They are still listed, with everything we know
          about them, because the filing exists even when the file will not open. Retrying later
          sometimes works.
        </p>
      </div>
    )}

    <Source source={fdpSource} label="this index" />

    <section class="section" aria-labelledby="filings-title">
      <h2 id="filings-title">Filings</h2>

      <form class="filters" role="search" aria-label="Filter filings" style="--filter-cols: 4">
        <p class="field">
          <label for="f-search">Search</label>
          <input
            type="search"
            id="f-search"
            name="search"
            placeholder="Form name or period"
            autocomplete="off"
          />
        </p>
        <p class="field">
          <label for="f-year">Year</label>
          <select id="f-year" name="year">
            <option value="">All years</option>
            {fdpSummary.years.map((year) => <option value={year}>CY{year}</option>)}
          </select>
        </p>
        <p class="field">
          <label for="f-quarter">Quarter</label>
          <select id="f-quarter" name="quarter">
            <option value="">All quarters</option>
            <option value="annual">Annual (no quarter)</option>
            {fdpSummary.quarters.map((quarter) => <option value={quarter}>Q{quarter}</option>)}
          </select>
        </p>
        <p class="field">
          <label for="f-form">Form type</label>
          <select id="f-form" name="form">
            <option value="">All form types</option>
            {fdpSummary.forms.map((form) => (
              <option value={form.slug}>{form.label} ({form.count})</option>
            ))}
          </select>
        </p>
        <p class="field">
          <label for="f-availability">Availability</label>
          <select id="f-availability" name="availability">
            <option value="">Any</option>
            <option value="available">Downloadable</option>
            <option value="source-error">Unavailable at source</option>
          </select>
        </p>
        <p class="field">
          <button class="button" type="reset">Clear filters</button>
        </p>
      </form>

      <p class="result-count" id="result-count" role="status" aria-live="polite">
        Showing all {formatNumber(rows.length)} filings.
      </p>

      <ul class="filings" id="filing-list">
        {rows.map((row) => (
          <li
            class="filing"
            data-year={row.documentPeriod.year}
            data-quarter={row.documentPeriod.quarter ?? 'annual'}
            data-form={row.formSlug}
            data-availability={row.availability}
            data-search={row.search}
          >
            <div class="filing-main">
              <h3>{row.formLabel}</h3>
              <p class="tags">
                <span class="chip">{row.periodLabel}</span>
                <span class:list={['chip', row.availability === 'available' ? 'accent' : 'warn']}>
                  {AVAILABILITY_LABEL[row.availability] ?? row.availability}
                </span>
                {row.fileType && (
                  <span class="file-meta">
                    {row.fileType.toUpperCase()}
                    {row.sizeLabel && <> · {row.sizeLabel}</>}
                  </span>
                )}
              </p>
            </div>
            <p class="get">
              {row.availability === 'available' ? (
                <a class="button" href={row.downloadUrl} rel="noopener noreferrer nofollow">
                  Download<span class="visually-hidden">
                    {' '}{row.formLabel}, {row.periodLabel}, from DILG
                  </span>
                  <span aria-hidden="true">&nbsp;↗</span>
                </a>
              ) : (
                <a class="button" href={row.downloadUrl} rel="noopener noreferrer nofollow">
                  Try DILG link<span class="visually-hidden">
                    {' '}for {row.formLabel}, {row.periodLabel}
                  </span>
                  <span aria-hidden="true">&nbsp;↗</span>
                </a>
              )}
            </p>
            <details class="filing-more">
              <summary>
                Details<span class="visually-hidden"> for {row.formLabel}, {row.periodLabel}</span>
              </summary>
              <dl>
                <div>
                  <dt>Data period</dt>
                  <dd>{row.periodLabel} <span class="hint">— the period the document reports on</span></dd>
                </div>
                {row.postingLabel && (
                  <div>
                    <dt>Posting period</dt>
                    <dd>{row.postingLabel} <span class="hint">— when the LGU posted it</span></dd>
                  </div>
                )}
                <div>
                  <dt>Retrieved</dt>
                  <dd>
                    {formatDate(row.retrievedAt.slice(0, 10))}
                    <span class="hint">— when we last asked the portal</span>
                  </dd>
                </div>
                <div>
                  <dt>Verified</dt>
                  <dd>
                    {formatDate(fdpSource.lastVerified)}
                    <span class="hint">— when a maintainer last checked</span>
                  </dd>
                </div>
                {row.postingLocations.length > 0 && (
                  <div>
                    <dt>Posted at</dt>
                    <dd>{row.postingLocations.join(', ')}</dd>
                  </div>
                )}
                <div>
                  <dt>Reference</dt>
                  <dd>
                    <code>{row.id}</code> <span class="hint">— our id; DILG document {row.fdppId}</span>
                  </dd>
                </div>
                {row.contentSha256 && (
                  <div>
                    <dt>Content fingerprint</dt>
                    <dd><code class="hash">{row.contentSha256}</code></dd>
                  </div>
                )}
                {row.availability !== 'available' && (
                  <div>
                    <dt>Status</dt>
                    <dd>
                      The DILG link returned an error when we last checked
                      {row.lastKnownGoodAt && (
                        <> (last downloaded {formatDate(row.lastKnownGoodAt.slice(0, 10))})</>
                      )}.
                    </dd>
                  </div>
                )}
              </dl>
            </details>
          </li>
        ))}
      </ul>

      <p class="empty" id="no-results" hidden>No filings match these filters.</p>
    </section>
  </div>

  <script is:inline>
    // Progressive enhancement: without JS every filing is listed, which is a
    // perfectly usable page. With JS the filters narrow it in place.
    (function () {
      const form = document.querySelector('.filters');
      const list = document.getElementById('filing-list');
      const count = document.getElementById('result-count');
      const empty = document.getElementById('no-results');
      if (!form || !list || !count || !empty) return;

      const items = Array.from(list.querySelectorAll('.filing'));
      const total = items.length;

      function apply() {
        const data = new FormData(form);
        const search = String(data.get('search') || '').trim().toLowerCase();
        const year = String(data.get('year') || '');
        const quarter = String(data.get('quarter') || '');
        const formType = String(data.get('form') || '');
        const availability = String(data.get('availability') || '');
        let shown = 0;

        for (const item of items) {
          const ok =
            (!year || item.dataset.year === year) &&
            (!quarter || item.dataset.quarter === quarter) &&
            (!formType || item.dataset.form === formType) &&
            (!availability || item.dataset.availability === availability) &&
            (!search || (item.dataset.search || '').includes(search));
          item.hidden = !ok;
          if (ok) shown += 1;
        }

        empty.hidden = shown !== 0;
        count.textContent =
          shown === total
            ? 'Showing all ' + total + ' filings.'
            : 'Showing ' + shown + ' of ' + total + ' filings.';
      }

      form.addEventListener('input', apply);
      form.addEventListener('change', apply);
      form.addEventListener('reset', function () { setTimeout(apply, 0); });
      form.addEventListener('submit', function (event) { event.preventDefault(); apply(); });
    })();
  </script>
</Base>

<style>
  .page-body {
    padding-block: var(--sp-6) var(--sp-8);
  }
  .summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
    margin: 0 0 var(--sp-5);
  }
  @media (min-width: 48rem) {
    .summary {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .summary > div {
    padding-top: var(--sp-3);
    border-top: 2px solid var(--c-navy);
  }
  .summary dt {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .summary dd {
    margin: var(--sp-1) 0 0;
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--c-navy);
  }
  .of {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 400;
    color: var(--c-muted);
  }

  .filings {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: var(--border);
  }
  .filing {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-2) var(--sp-4);
    padding: var(--sp-4) 0;
    margin: 0;
    border-bottom: var(--border);
  }
  .filing[hidden] {
    display: none;
  }
  @media (min-width: 48rem) {
    .filing {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }
    .filing-more {
      grid-column: 1 / -1;
    }
  }
  .filing h3 {
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    font-weight: 650;
    color: var(--c-ink);
    margin: 0 0 var(--sp-2);
    line-height: 1.35;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin: 0;
  }
  .file-meta {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .get {
    margin: 0;
  }
  .filing-more > summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--c-accent);
    font-size: var(--fs-sm);
    font-weight: 650;
  }
  .filing-more > summary::after {
    content: '+';
    margin-left: var(--sp-2);
  }
  .filing-more[open] > summary::after {
    content: '−';
  }
  .filing-more dl {
    display: grid;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    background: var(--c-surface);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
  }
  .filing-more dl > div {
    display: grid;
    gap: 2px;
  }
  @media (min-width: 40rem) {
    .filing-more dl > div {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--sp-3);
    }
  }
  .filing-more dt {
    color: var(--c-muted);
    font-weight: 650;
  }
  .filing-more dd {
    margin: 0;
  }
  .hint {
    color: var(--c-muted);
  }
  .hash {
    font-size: 0.72rem;
    overflow-wrap: anywhere;
  }
  .empty {
    color: var(--c-muted);
    padding: var(--sp-5) 0;
  }
</style>
