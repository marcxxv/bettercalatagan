---
import Base from '../layouts/Base.astro';
import Source from '../components/Source.astro';
import { fdpDataset, fdpSource, fdpSummary, formatBytes } from '../data/fdp';
import { formatPeriod } from '../data/schemas/fdp';

const records = fdpDataset.records;
const number = new Intl.NumberFormat('en-PH');

const AVAILABILITY_LABEL: Record<string, string> = {
  available: 'Available',
  'source-error': 'Unavailable at source',
  'missing-from-source': 'No longer listed',
  'not-checked': 'Not checked',
};

const rows = records.map((record) => ({
  ...record,
  periodLabel: formatPeriod(record.documentPeriod),
  postingLabel: record.postingPeriod ? formatPeriod(record.postingPeriod) : null,
  sizeLabel: formatBytes(record.byteLength),
  search: [record.formLabel, formatPeriod(record.documentPeriod), record.id]
    .join(' ')
    .toLowerCase(),
}));
---

<Base
  title="Transparency"
  description="An index of every Full Disclosure Policy filing the Municipality of Calatagan has posted to the DILG portal, with a link to each original document."
>
  <h1>Transparency filings</h1>

  <p>
    Philippine local governments must publish certain financial and procurement documents under the
    DILG's Full Disclosure Policy. This is an index of every such filing the Municipality of
    Calatagan has posted, with a link to the original document on the DILG portal.
  </p>
  <p>
    <strong>This page indexes documents, not figures.</strong> No amount on this page has been
    extracted from a spreadsheet or restated — each entry sends you to the DILG original so you can
    read it yourself.
  </p>

  <dl class="facts">
    <dt>Filings indexed</dt>
    <dd>{number.format(fdpSummary.total)}</dd>
    <dt>Form types</dt>
    <dd>{fdpSummary.forms.length} of 14 statutory forms</dd>
    <dt>Periods covered</dt>
    <dd>CY{Math.min(...fdpSummary.years)}–CY{Math.max(...fdpSummary.years)}</dd>
    <dt>Downloadable now</dt>
    <dd>
      {number.format(fdpSummary.available)} of {number.format(fdpSummary.total)}
      {fdpSummary.sourceError > 0 && (
        <> · {number.format(fdpSummary.sourceError)} failing at the DILG portal</>
      )}
    </dd>
  </dl>

  {fdpSummary.sourceError > 0 && (
    <p class="notice">
      Some documents cannot be downloaded because the DILG portal returns a server error for them.
      Those filings are still listed here, with everything we know about them, because the filing
      exists even when the file will not open. Retrying later sometimes works.
    </p>
  )}

  <Source source={fdpSource} />

  <h2 id="filings">Filings</h2>

  <form class="filters" role="search" aria-labelledby="filters-heading">
    <h3 id="filters-heading" class="visually-hidden">Filter filings</h3>

    <p class="field">
      <label for="f-search">Search</label>
      <input type="search" id="f-search" name="search" placeholder="Form name or period" autocomplete="off" />
    </p>

    <p class="field">
      <label for="f-year">Year</label>
      <select id="f-year" name="year">
        <option value="">All years</option>
        {fdpSummary.years.map((year) => <option value={year}>CY{year}</option>)}
      </select>
    </p>

    <p class="field">
      <label for="f-quarter">Quarter</label>
      <select id="f-quarter" name="quarter">
        <option value="">All quarters</option>
        <option value="annual">Annual (no quarter)</option>
        {fdpSummary.quarters.map((quarter) => <option value={quarter}>Q{quarter}</option>)}
      </select>
    </p>

    <p class="field wide">
      <label for="f-form">Form type</label>
      <select id="f-form" name="form">
        <option value="">All form types</option>
        {fdpSummary.forms.map((form) => (
          <option value={form.slug}>{form.label} ({form.count})</option>
        ))}
      </select>
    </p>

    <p class="field">
      <label for="f-availability">Availability</label>
      <select id="f-availability" name="availability">
        <option value="">Any</option>
        <option value="available">Downloadable</option>
        <option value="source-error">Unavailable at source</option>
      </select>
    </p>

    <p class="field actions">
      <button type="reset">Clear filters</button>
    </p>
  </form>

  <p class="count" id="result-count" role="status" aria-live="polite">
    Showing all {number.format(rows.length)} filings.
  </p>

  <ul class="filings" id="filing-list">
    {rows.map((row) => (
      <li
        class="filing"
        data-year={row.documentPeriod.year}
        data-quarter={row.documentPeriod.quarter ?? 'annual'}
        data-form={row.formSlug}
        data-availability={row.availability}
        data-search={row.search}
      >
        <h3>{row.formLabel}</h3>

        <p class="period">
          <span class="chip">{row.periodLabel}</span>
          <span class={`chip state ${row.availability}`}>
            {AVAILABILITY_LABEL[row.availability] ?? row.availability}
          </span>
        </p>

        <dl>
          <dt>Data period</dt>
          <dd>{row.periodLabel}<span class="hint"> — the period the document reports on</span></dd>

          {row.postingLabel && (
            <>
              <dt>Posting period</dt>
              <dd>{row.postingLabel}<span class="hint"> — when the LGU posted it</span></dd>
            </>
          )}

          <dt>Retrieved</dt>
          <dd>{row.retrievedAt.slice(0, 10)}<span class="hint"> — when we last asked the portal</span></dd>

          <dt>Verified</dt>
          <dd>{fdpSource.lastVerified}<span class="hint"> — when a maintainer last checked</span></dd>

          {row.postingLocations.length > 0 && (
            <>
              <dt>Posted at</dt>
              <dd>{row.postingLocations.join(', ')}</dd>
            </>
          )}

          <dt>Reference</dt>
          <dd>
            <code>{row.id}</code>
            <span class="hint"> — our id; DILG document {row.fdppId}</span>
          </dd>

          {row.contentSha256 && (
            <>
              <dt>File</dt>
              <dd>
                {row.fileType?.toUpperCase()}{row.sizeLabel && <> · {row.sizeLabel}</>}
                <br /><code class="hash">content {row.contentSha256}</code>
              </dd>
            </>
          )}
        </dl>

        <p class="get">
          {row.availability === 'available' ? (
            <a class="dl" href={row.downloadUrl} rel="noopener noreferrer nofollow">
              Download from DILG ↗
            </a>
          ) : (
            <>
              <a href={row.downloadUrl} rel="noopener noreferrer nofollow">Try the DILG link ↗</a>
              <span class="hint">
                {' '}— this returned an error when we last checked
                {row.lastKnownGoodAt && <> (last downloaded {row.lastKnownGoodAt.slice(0, 10)})</>}
              </span>
            </>
          )}
        </p>
      </li>
    ))}
  </ul>

  <p class="empty" id="no-results" hidden>No filings match these filters.</p>

  <script is:inline>
    // Progressive enhancement: without JS every filing is listed, which is a
    // perfectly usable page. With JS the filters narrow it in place.
    (function () {
      const form = document.querySelector('.filters');
      const list = document.getElementById('filing-list');
      const count = document.getElementById('result-count');
      const empty = document.getElementById('no-results');
      if (!form || !list || !count || !empty) return;

      const items = Array.from(list.querySelectorAll('.filing'));
      const total = items.length;

      function apply() {
        const data = new FormData(form);
        const search = String(data.get('search') || '').trim().toLowerCase();
        const year = String(data.get('year') || '');
        const quarter = String(data.get('quarter') || '');
        const formType = String(data.get('form') || '');
        const availability = String(data.get('availability') || '');
        let shown = 0;

        for (const item of items) {
          const ok =
            (!year || item.dataset.year === year) &&
            (!quarter || item.dataset.quarter === quarter) &&
            (!formType || item.dataset.form === formType) &&
            (!availability || item.dataset.availability === availability) &&
            (!search || (item.dataset.search || '').includes(search));
          item.hidden = !ok;
          if (ok) shown += 1;
        }

        empty.hidden = shown !== 0;
        count.textContent =
          shown === total
            ? 'Showing all ' + total + ' filings.'
            : 'Showing ' + shown + ' of ' + total + ' filings.';
      }

      form.addEventListener('input', apply);
      form.addEventListener('change', apply);
      form.addEventListener('reset', function () { setTimeout(apply, 0); });
      form.addEventListener('submit', function (event) { event.preventDefault(); apply(); });
    })();
  </script>

  <style>
    .notice {
      background: var(--warn-bg);
      border: 1px solid var(--warn-line);
      border-radius: 4px;
      padding: 10px 12px;
      font-size: 0.9rem;
    }
    .visually-hidden {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip: rect(0 0 0 0); white-space: nowrap;
    }
    .filters {
      display: flex; flex-wrap: wrap; gap: 12px 16px;
      border: 1px solid var(--line); border-radius: 6px;
      padding: 14px 16px; margin-block: 16px;
    }
    .field { display: flex; flex-direction: column; gap: 4px; margin: 0; flex: 1 1 150px; }
    .field.wide { flex-basis: 260px; }
    .field.actions { justify-content: flex-end; flex: 0 0 auto; }
    .filters label { font-size: 0.78rem; font-weight: 600; color: var(--muted); }
    .filters input, .filters select, .filters button {
      font: inherit; font-size: 0.9rem; padding: 7px 9px;
      border: 1px solid var(--line); border-radius: 4px;
      background: var(--bg); color: var(--fg); min-height: 38px; max-width: 100%;
    }
    .filters button { cursor: pointer; }
    .filters :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

    .count { font-size: 0.85rem; color: var(--muted); }
    ul.filings { list-style: none; padding: 0; margin: 0; }
    .filing {
      border: 1px solid var(--line); border-radius: 6px;
      padding: 14px 16px; margin-bottom: 12px;
    }
    .filing[hidden] { display: none; }
    .filing h3 { margin: 0 0 6px; font-size: 1rem; line-height: 1.35; }
    .period { margin: 0 0 10px; display: flex; flex-wrap: wrap; gap: 6px; }
    .chip {
      display: inline-block; font-size: 0.75rem; font-weight: 600;
      padding: 2px 8px; border-radius: 10px;
      border: 1px solid var(--line); color: var(--muted);
    }
    .chip.state.available { border-color: #2e8b57; color: #2e8b57; }
    .chip.state.source-error,
    .chip.state.missing-from-source { border-color: #c07800; color: #c07800; }

    .filing dl { display: grid; grid-template-columns: max-content 1fr; gap: 3px 14px; margin: 0; font-size: 0.85rem; }
    .filing dt { color: var(--muted); font-weight: 600; }
    .filing dd { margin: 0; }
    .hint { color: var(--muted); font-weight: 400; }
    .hash { font-size: 0.72rem; color: var(--muted); word-break: break-all; }
    .get { margin: 10px 0 0; font-size: 0.88rem; }
    .dl { font-weight: 600; }
    .empty { color: var(--muted); }

    @media (max-width: 520px) {
      .filing dl { grid-template-columns: 1fr; }
      .filing dd { margin-bottom: 8px; }
      .field { flex-basis: 100%; }
    }
  </style>
</Base>
