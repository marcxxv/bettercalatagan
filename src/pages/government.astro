---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { archivedDocuments } from '../data/documents';
import { KIND_LABELS } from '../data/schemas/documents';
import { archiveReadAttrs } from '../lib/viewer';
import Source from '../components/Source.astro';
import Icon from '../components/Icon.astro';
import { barangayOffices, municipalOffices, officesSource, TERM } from '../data/offices';
import { formatNumber } from '../lib/format';

/**
 * A deliberate gap page.
 *
 * Who holds office and how to reach each office are the two things residents
 * most often want, and they are exactly what this project cannot currently
 * source to its own standard. Saying so plainly, and saying where to look
 * instead, is more useful than a confident page that might be wrong.
 */

const officeDocuments = archivedDocuments.documents
  .filter((doc) => doc.kind === 'office-document' || doc.kind === 'citizens-charter')
  .sort((a, b) => (b.publishedYear ?? 0) - (a.publishedYear ?? 0) || a.title.localeCompare(b.title));

const latestOfficeYear = Math.max(...officeDocuments.map((doc) => doc.publishedYear ?? 0));
const age = new Date().getUTCFullYear() - latestOfficeYear;
const crumbs = [{ name: 'Government', href: '/government' }];
---

<Base
  title="Government of Calatagan"
  description="Who holds municipal office in Calatagan, Batangas, and how to reach each office — what can and cannot yet be verified from primary sources, and where to look instead."
  {crumbs}
>
  <PageHeader
    eyebrow="Government"
    icon="landmark"
    title="Who governs Calatagan — and what we can prove"
    lede="Who holds office and how to reach each office are what residents ask for most. They are also the two things this project cannot yet establish to its evidence standard, so this page sets out the gap instead of filling it with a plausible guess."
    {crumbs}
  />

  <div class="container wide with-rail page-body">
    <aside class="rail">
      <nav class="rail-nav" aria-labelledby="toc-label" data-spy>
        <p class="rail-title" id="toc-label">On this page</p>
        <ul>
          <li><a href="#offices">Offices of government</a></li>
          <li><a href="#officials">Who holds office</a></li>
          <li><a href="#contacts">Offices and contacts</a></li>
          <li><a href="#archive">What the archive holds</a></li>
          <li><a href="#reach">Reaching the municipality</a></li>
        </ul>
      </nav>
    </aside>
    <div class="content">
    <section class="section" id="offices" aria-labelledby="offices-title">
      <div class="prose">
        <h2 id="offices-title">Offices of government</h2>
        <p>
          The Local Government Code creates the same offices in every municipality and barangay.
          These are Calatagan’s, with what the Code says each one does. Who holds each office is
          not published here — <a href="#officials">see why</a>.
        </p>
      </div>
      <div class="office-grid">
        {[
          { heading: 'Municipality', icon: 'landmark' as const, offices: municipalOffices },
          { heading: 'In each of the 25 barangays', icon: 'home' as const, offices: barangayOffices },
        ].map((group) => (
          <section class="office-panel" aria-label={group.heading}>
            <h3 class="office-head"><span class="office-icon" aria-hidden="true"><Icon name={group.icon} size="18" /></span>{group.heading}</h3>
            <ul class="office-list">
              {group.offices.map((o) => (
                <li class="office">
                  <div class="office-top">
                    <p class="office-title">{o.title}{o.local && <span class="office-local"> · {o.local}</span>}</p>
                    {o.seats !== undefined && (
                      <p class="office-seats"><strong>{formatNumber(o.seats)}</strong> {o.seats === 1 ? 'seat' : 'seats'}</p>
                    )}
                  </div>
                  <p class="office-role">{o.role}</p>
                  <p class="office-meta">
                    <span>RA 7160, {o.section}</span>
                    <a href="#officials" class="office-holder"><Icon name="eye-off" size="13" />Officeholder not published</a>
                  </p>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="office-term"><Icon name="clock" size="16" /><span>{TERM.text} <span class="muted">(RA 7160, {TERM.section})</span></span></p>
      <Source source={officesSource} label="these offices" />
    </section>

    <section class="section prose" id="officials" aria-labelledby="officials-title">
      <h2 id="officials-title">Who holds office</h2>
      <p>
        Calatagan elects a Mayor, a Vice Mayor and eight members of the Sangguniang Bayan. The May
        2025 local elections have been held and the results are a matter of public record.
      </p>
      <div class="callout clay">
        <p class="callout-title">Why the roster is not published here</p>
        <p>
          <em>An election result is not proof of present incumbency.</em> Between an election and
          today, an officeholder can resign, be suspended, be disqualified, die, or be succeeded.
          Publishing election winners as current officials asserts something the election return
          does not say.
        </p>
      </div>
      <h3>What we would need to publish it</h3>
      <ul>
        <li>
          A Commission on Elections certificate of canvass or official published return, rather
          than media reporting of the count.
        </li>
        <li>
          A current roster from the Department of the Interior and Local Government or its
          municipal field office, confirming who is in office now.
        </li>
      </ul>
      <p>
        Lists that circulate on social media — including campaign posts naming every barangay
        captain and kagawad who endorsed a candidate — are not used either: they record who
        supported a campaign, not who holds office today, and barangay offices change with each
        barangay election.
      </p>
      <p>
        This project has not yet been able to obtain either. COMELEC’s published attachment
        directories could not be retrieved by this project’s tools, and we have not found a DILG
        roster we can cite. Election results are available from civic-tech derivatives of COMELEC data and from
        news organisations; both are useful for finding the answer and neither is sufficient to
        publish it.
      </p>
      <p class="small muted">
        Tracked as an open item in <a href="/sources#withheld">Sources</a>. If you have a primary
        document, a correction with a citation is welcome.
      </p>
    </section>

    <section class="section prose" id="contacts" aria-labelledby="contacts-title">
      <h2 id="contacts-title">Offices and contact details</h2>
      <p>
        Calatagan’s emergency and office hotlines, as provided by the municipal government, are on
        the <a href="/hotlines">Hotlines</a> page: the MDRRMO, police, fire, health, Coast Guard and
        others, with 911 first.
      </p>
      <p>
        An older record of the municipal hall’s telephone, e-mail and address on a national
        portal (DTI’s competitiveness profile) is not used: other fields in the same record, such as
        the income class and website, are out of date.
      </p>
    </section>

    <section class="section" id="archive" aria-labelledby="archive-title">
      <div class="prose">
        <h2 id="archive-title">What the archive holds</h2>
        <p>
          The municipality’s former website published a set of {officeDocuments.length} per-office
          documents, most of them in {latestOfficeYear}. A sample has been opened: they are{' '}
          <strong>Citizen’s Charter service standards</strong> in the Anti-Red Tape Authority format
          — each service listing its requirements, fees and processing times.
        </p>
        <div class="callout warn">
          <p class="callout-title">Archived, not current</p>
          <p>
            The {latestOfficeYear} set is {age} years old. A fee or a processing time from it is a
            starting point for a question at the municipal hall, never an answer. These pages do not
            restate any of those figures (the assistant can quote a document's own text, dated and
            with that caveat) — nor the e-mail addresses and telephone numbers in the
            one-page <em>List of Offices</em>, which the only other record of them cannot confirm.
            The document is linked below so you can judge its age for yourself.
          </p>
        </div>
      </div>

      <div class="table-wrap" role="region" aria-labelledby="office-caption" tabindex="0">
        <table class="stack">
          <caption id="office-caption">
            Per-office documents from the former municipal website ({officeDocuments.length})
          </caption>
          <thead>
            <tr>
              <th scope="col">Document</th>
              <th scope="col">Kind</th>
              <th scope="col">Published</th>
              <th scope="col">Archived copy</th>
            </tr>
          </thead>
          <tbody>
            {officeDocuments.map((doc) => (
              <tr>
                <th scope="row">{doc.title}</th>
                <td data-label="Kind">{KIND_LABELS[doc.kind]}</td>
                <td data-label="Published">{doc.publishedYear ?? '—'}</td>
                <td data-label="Archived copy">
                  {archiveReadAttrs(doc) ? (
                    <a href={doc.archiveUrl} rel="noopener noreferrer nofollow" {...archiveReadAttrs(doc)}>
                      Read<span class="visually-hidden"> {doc.title}</span>
                    </a>
                  ) : (
                    <a href={doc.archiveUrl} rel="noopener noreferrer nofollow">
                      Get file<span class="visually-hidden"> {doc.title} from the Wayback Machine</span>
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted prose">
        Entries a maintainer has actually opened carry a note saying what was found inside; the rest
        are described by the filename the municipality chose. All of them appear in the
        <a href="/documents">archive</a>.
      </p>
    </section>

    <section class="section prose" id="reach" aria-labelledby="reach-title">
      <h2 id="reach-title">If you need to reach the municipality today</h2>
      <p>
        Call the municipal lines on the <a href="/hotlines">Hotlines</a> page, go in person to the
        municipal hall, or contact the Provincial Government of Batangas. In an emergency, call 911.
      </p>
    </section>
    </div>
  </div>
</Base>

<style>
  .page-body {
    padding-block: var(--sp-7) var(--sp-8);
  }
  .section {
    padding-block: 0 var(--sp-8);
  }
  .section {
    scroll-margin-top: var(--sp-5);
  }
  .callout {
    margin-block: var(--sp-5);
  }
  th[scope='row'] {
    font-weight: 600;
  }
</style>

<style>
  .office-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-5, var(--sp-4));
  }
  .office-panel {
    padding: var(--sp-4) var(--sp-5, var(--sp-4));
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
  }
  .office-head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-lg);
  }
  .office-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    background: var(--c-accent-wash);
    color: var(--c-accent);
  }
  .office-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .office {
    display: grid;
    gap: 4px;
    padding: var(--sp-3) 0;
    border-top: 1px solid var(--c-line);
  }
  .office-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--sp-3);
  }
  .office-top p,
  .office-role,
  .office-meta {
    margin: 0;
  }
  .office-title {
    font-weight: 650;
    color: var(--c-ink);
  }
  .office-local {
    color: var(--c-muted);
    font-weight: 500;
  }
  .office-seats {
    white-space: nowrap;
    color: var(--c-muted);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
  .office-seats strong {
    color: var(--c-ink);
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    font-weight: 500;
  }
  .office-role {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .office-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }
  .office-holder {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--c-muted);
  }
  .office-holder:hover {
    color: var(--c-accent);
  }
  .office-term {
    display: flex;
    gap: var(--sp-2);
    align-items: flex-start;
    margin: var(--sp-4) 0 0;
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
  }
  .office-term :global(.icon) {
    flex: none;
    margin-top: 3px;
    color: var(--c-accent);
  }
</style>
