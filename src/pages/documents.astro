---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Source from '../components/Source.astro';
import { archivedDocuments, documentKinds, documentYears, documentsSource } from '../data/documents';
import { KIND_LABELS } from '../data/schemas/documents';
import { formatDate, formatNumber } from '../lib/format';

const docs = archivedDocuments.documents;

const sizeLabel = (bytes: number | null) => {
  if (bytes === null) return null;
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
};

const kindLabel = (kind: string) => KIND_LABELS[kind as keyof typeof KIND_LABELS] ?? kind;

const rows = docs.map((doc) => ({
  ...doc,
  kindLabel: KIND_LABELS[doc.kind],
  size: sizeLabel(doc.byteLength),
  search: `${doc.title} ${doc.filename} ${KIND_LABELS[doc.kind]}`.toLowerCase(),
}));
const inspectedCount = docs.filter((doc) => doc.inspected).length;
const kindMax = Math.max(1, ...documentKinds.map((k) => k.count));

const crumbs = [{ name: 'Archive', href: '/documents' }];
---

<Base
  title="Archived Calatagan municipal documents"
  description={`${formatNumber(archivedDocuments.documentCount)} documents recovered from the former Calatagan municipal website — ordinances, plans, reports and forms — indexed as a historical record.`}
  {crumbs}
>
  <PageHeader
    eyebrow="Archive"
    title="Documents from the former municipal website"
    lede="What calatagan.gov.ph published is still public record. This indexes every document the Internet Archive still holds, with a link to each one — as a historical record, not as the municipality’s current position."
    {crumbs}
  />

  <div class="container page-body">
    <div class="callout warn">
      <p class="callout-title">The municipality’s website is offline</p>
      <p>
        <code>calatagan.gov.ph</code> no longer resolves — the domain is still delegated to
        government nameservers, but it has no address record, and the Internet Archive holds no
        capture after 2025.
      </p>
    </div>

    <div class="prose">
      <p>
        <strong>These are historical documents.</strong> None of them should be read as the
        municipality’s current position, current fees, or current procedure. Some are clearly
        expired — a land use plan for 2001–2010, for instance. Others may or may not still reflect
        practice; without a live official source there is no way to tell, and this site will not
        pretend otherwise.
      </p>
      <p>
        Most entries are described by the filename the municipality chose. Where a maintainer has
        actually opened a document ({inspectedCount} so far), what was found inside is noted on the
        entry — the difference between “we know what this is” and “this is what the file was
        called” is worth keeping visible.
      </p>
    </div>

    <Source source={documentsSource} label="this archive" />

    <section class="section" aria-labelledby="kinds-title">
      <h2 id="kinds-title">What is here</h2>
      <div class="table-wrap narrow" role="region" aria-labelledby="kinds-caption" tabindex="0">
        <table class="kinds">
          <caption id="kinds-caption">
            {formatNumber(archivedDocuments.documentCount)} archived documents by kind
          </caption>
          <thead>
            <tr>
              <th scope="col">Kind</th>
              <th scope="col" class="num">Documents</th>
            </tr>
          </thead>
          <tbody>
            {documentKinds.map(({ kind, count }) => (
              <tr>
                <th scope="row">{kindLabel(kind)}</th>
                <td class="num">
                  {formatNumber(count)}
                  <span
                    class="bar"
                    aria-hidden="true"
                    style={`--w:${((count / kindMax) * 100).toFixed(1)}%`}
                  ></span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="index-title">
      <h2 id="index-title">The index</h2>

      <form class="filters" role="search" aria-label="Filter documents" style="--filter-cols: 2">
        <p class="field">
          <label for="d-search">Search</label>
          <input
            type="search"
            id="d-search"
            name="search"
            placeholder="Title or filename"
            autocomplete="off"
          />
        </p>
        <p class="field">
          <label for="d-kind">Kind</label>
          <select id="d-kind" name="kind">
            <option value="">All kinds</option>
            {documentKinds.map(({ kind, count }) => (
              <option value={kind}>{kindLabel(kind)} ({count})</option>
            ))}
          </select>
        </p>
        <p class="field">
          <label for="d-year">Published</label>
          <select id="d-year" name="year">
            <option value="">Any year</option>
            {documentYears.map((year) => <option value={year}>{year}</option>)}
          </select>
        </p>
        <p class="field">
          <button class="button" type="reset">Clear filters</button>
        </p>
      </form>

      <p class="result-count" id="doc-count" role="status" aria-live="polite">
        Showing all {formatNumber(rows.length)} documents.
      </p>

      <ul class="docs" id="doc-list">
        {rows.map((doc) => (
          <li class="doc" data-kind={doc.kind} data-year={doc.publishedYear ?? ''} data-search={doc.search}>
            <div class="doc-main">
              <h3>{doc.title}</h3>
              <p class="tags">
                <span class="chip">{doc.kindLabel}</span>
                {doc.status === 'superseded' ? (
                  <span class="chip warn">Superseded</span>
                ) : (
                  <span class="chip clay">Archived</span>
                )}
                {doc.publishedYear && <span class="chip">Published {doc.publishedYear}</span>}
                {doc.inspected && <span class="chip accent">Opened and checked</span>}
                <span class="file-meta">
                  {doc.fileType.toUpperCase()}
                  {doc.size && ` · ${doc.size}`}
                </span>
              </p>
              {doc.inspected && (
                <p class="inspected">
                  Opened {formatDate(doc.inspected.inspectedOn)} ({doc.inspected.pages}
                  {doc.inspected.pages === 1 ? ' page' : ' pages'}): {doc.inspected.summary}
                </p>
              )}
              <p class="hint">
                Captured {formatDate(doc.capturedAt.slice(0, 10))} · original address{' '}
                <code>{doc.originalUrl}</code> (dead)
              </p>
            </div>
            <p class="get">
              <a class="button" href={doc.archiveUrl} rel="noopener noreferrer nofollow">
                Open copy<span class="visually-hidden"> of {doc.title} on the Wayback Machine</span>
                <span aria-hidden="true">&nbsp;↗</span>
              </a>
            </p>
          </li>
        ))}
      </ul>

      <p class="empty" id="doc-empty" hidden>No documents match these filters.</p>
    </section>
  </div>

  <script is:inline>
    (function () {
      const form = document.querySelector('.filters');
      const list = document.getElementById('doc-list');
      const count = document.getElementById('doc-count');
      const empty = document.getElementById('doc-empty');
      if (!form || !list || !count || !empty) return;
      const items = Array.from(list.querySelectorAll('.doc'));
      const total = items.length;

      function apply() {
        const data = new FormData(form);
        const search = String(data.get('search') || '').trim().toLowerCase();
        const kind = String(data.get('kind') || '');
        const year = String(data.get('year') || '');
        let shown = 0;
        for (const item of items) {
          const ok =
            (!kind || item.dataset.kind === kind) &&
            (!year || item.dataset.year === year) &&
            (!search || (item.dataset.search || '').includes(search));
          item.hidden = !ok;
          if (ok) shown += 1;
        }
        empty.hidden = shown !== 0;
        count.textContent =
          shown === total
            ? 'Showing all ' + total + ' documents.'
            : 'Showing ' + shown + ' of ' + total + ' documents.';
      }

      form.addEventListener('input', apply);
      form.addEventListener('change', apply);
      form.addEventListener('reset', function () { setTimeout(apply, 0); });
      form.addEventListener('submit', function (e) { e.preventDefault(); apply(); });
    })();
  </script>
</Base>

<style>
  .page-body {
    padding-block: var(--sp-6) var(--sp-8);
  }
  .callout {
    margin-top: 0;
  }
  .narrow {
    max-width: 32rem;
  }
  .kinds td.num {
    vertical-align: top;
  }
  .bar {
    display: block;
    height: 4px;
    margin: var(--sp-1) 0 0 auto;
    width: var(--w);
    max-width: 8rem;
    background: var(--c-clay);
    border-radius: 2px;
    opacity: 0.6;
  }

  .docs {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: var(--border);
  }
  .doc {
    display: grid;
    gap: var(--sp-3) var(--sp-4);
    padding: var(--sp-4) 0;
    margin: 0;
    border-bottom: var(--border);
  }
  .doc[hidden] {
    display: none;
  }
  @media (min-width: 48rem) {
    .doc {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }
  }
  .doc h3 {
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    font-weight: 650;
    color: var(--c-ink);
    line-height: 1.35;
    margin: 0 0 var(--sp-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-2);
  }
  .file-meta {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .inspected {
    margin: 0 0 var(--sp-2);
    padding-left: var(--sp-3);
    border-left: 3px solid var(--c-accent);
    font-size: var(--fs-sm);
    max-width: var(--w-prose);
  }
  .hint {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .hint code {
    overflow-wrap: anywhere;
    font-size: 0.72rem;
  }
  .get {
    margin: 0;
  }
  .empty {
    color: var(--c-muted);
    padding: var(--sp-5) 0;
  }
</style>
