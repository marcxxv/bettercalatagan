---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Source from '../components/Source.astro';
import Icon from '../components/Icon.astro';
import { archivedDocuments, documentKinds, documentYears, documentsSource } from '../data/documents';
import { KIND_LABELS } from '../data/schemas/documents';
import { formatDate, formatNumber } from '../lib/format';
import { archiveReadAttrs } from '../lib/viewer';

const docs = archivedDocuments.documents;

const sizeLabel = (bytes: number | null) => {
  if (bytes === null) return null;
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
};

const kindLabel = (kind: string) => KIND_LABELS[kind as keyof typeof KIND_LABELS] ?? kind;

const rows = docs.map((doc) => ({
  ...doc,
  kindLabel: KIND_LABELS[doc.kind],
  size: sizeLabel(doc.byteLength),
  search: `${doc.title} ${doc.filename} ${KIND_LABELS[doc.kind]}`.toLowerCase(),
  read: archiveReadAttrs(doc),
}));
const inspectedCount = docs.filter((doc) => doc.inspected).length;
const kindMax = Math.max(1, ...documentKinds.map((k) => k.count));
const superseded = docs.filter((doc) => doc.status === 'superseded').length;
const years = docs.map((d) => d.publishedYear).filter((y): y is number => y !== null);
const span = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '—';

const crumbs = [{ name: 'Archive', href: '/documents' }];

const origin = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Calatagan, Batangas — documents archived from the former municipal website',
    description: `An index of ${archivedDocuments.documentCount} documents that calatagan.gov.ph published and the Internet Archive preserved: ordinances, plans, reports, notices of award and forms, classified by kind and year, each linked to its archived copy.`,
    url: new URL('/documents', origin).toString(),
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    creator: { '@id': new URL('/#publisher', origin).toString() },
    temporalCoverage: years.length ? `${Math.min(...years)}/${Math.max(...years)}` : undefined,
    spatialCoverage: { '@type': 'Place', name: 'Calatagan, Batangas, Philippines' },
    isBasedOn: documentsSource.sources.map((s) => s.url),
    dateModified: documentsSource.lastVerified,
    distribution: [
      {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: new URL('/data/documents.json', origin).toString(),
      },
    ],
  },
];
---

<Base
  title="Archived Calatagan municipal documents"
  description={`${formatNumber(archivedDocuments.documentCount)} documents recovered from the former Calatagan municipal website — ordinances, plans, reports and forms — readable on this site as a historical record.`}
  {crumbs}
  {jsonLd}
>
  <PageHeader
    eyebrow="Archive"
    icon="archive"
    title="Documents from the former municipal website"
    lede="What calatagan.gov.ph published is still public record. This indexes every document the Internet Archive still holds, with a link to each one — as a historical record, not as the municipality’s current position."
    {crumbs}
  >
    <dl slot="aside" class="aside-stats">
      <div><dt>Documents</dt><dd class="figure">{formatNumber(archivedDocuments.documentCount)}</dd></div>
      <div><dt>Published</dt><dd class="figure">{span}</dd></div>
      <div><dt>Opened &amp; checked</dt><dd class="figure">{inspectedCount}</dd></div>
    </dl>
  </PageHeader>

  <div class="container wide page-body">
    <div class="lead-grid">
      <div class="callout warn offline">
        <p class="callout-title"><Icon name="alert" size="18" /> The municipality’s website is offline</p>
        <p>
          <code>calatagan.gov.ph</code> no longer resolves — the domain is still delegated to
          government nameservers, but it has no address record, and the Internet Archive holds no
          capture after 2025.
        </p>
      </div>
      <div class="prose">
        <p>
          <strong>These are historical documents.</strong> None of them should be read as the
          municipality’s current position, current fees, or current procedure. Some are clearly
          expired — a land use plan for 2001–2010, for instance. Others may or may not still reflect
          practice; without a live official source there is no way to tell, and this site will not
          pretend otherwise.
        </p>
        <p>
          Most entries are described by the filename the municipality chose. Where a maintainer has
          actually opened a document ({inspectedCount} so far), what was found inside is noted on the
          entry — the difference between “we know what this is” and “this is what the file was
          called” is worth keeping visible.
        </p>
      </div>
    </div>

    <Source source={documentsSource} label="this archive" />

    <section class="section-block" aria-labelledby="kinds-title">
      <p class="eyebrow">What is here</p>
      <h2 id="kinds-title">{formatNumber(archivedDocuments.documentCount)} documents by kind</h2>
      <p class="muted js-block">Select a kind to list just those documents.</p>
      <ul class="kinds" data-animate>
        {documentKinds.map(({ kind, count }, i) => (
          <li>
            <button
              type="button"
              class="kind"
              data-set-filter={`kind=${kind}`}
              data-for="doc-list"
              aria-pressed="false"
            >
              <span class="k-label">{kindLabel(kind)}</span>
              <span class="k-bar" aria-hidden="true">
                <span data-grow style={`width:${((count / kindMax) * 100).toFixed(1)}%;--reveal-delay:${i * 50}ms`}></span>
              </span>
              <span class="k-count num">{formatNumber(count)}</span>
            </button>
          </li>
        ))}
      </ul>
      {superseded > 0 && <p class="small muted">{superseded} are marked superseded by a later document.</p>}
    </section>

    <section class="section-block" id="index" aria-labelledby="index-title">
      <p class="eyebrow">Index</p>
      <h2 id="index-title">Every archived document</h2>

      <form class="toolbar" data-filter="doc-list" data-noun="documents" role="search" aria-label="Filter documents" style="--filter-cols: 2" hidden>
        <p class="field search">
          <label for="d-search">Search</label>
          <input type="search" id="d-search" name="q" placeholder="Title or filename" autocomplete="off" />
        </p>
        <p class="field">
          <label for="d-kind">Kind</label>
          <select id="d-kind" name="kind">
            <option value="">All kinds</option>
            {documentKinds.map(({ kind, count }) => (
              <option value={kind}>{kindLabel(kind)} ({count})</option>
            ))}
          </select>
        </p>
        <p class="field">
          <label for="d-year">Published</label>
          <select id="d-year" name="year">
            <option value="">Any year</option>
            {documentYears.map((year) => <option value={String(year)}>{year}</option>)}
          </select>
        </p>
        <p class="field">
          <button class="button" type="reset">Reset</button>
        </p>
      </form>

      <div class="result-bar">
        <p class="result-count" data-count-for="doc-list" role="status" aria-live="polite">
          Showing all <strong>{formatNumber(rows.length)}</strong> documents
        </p>
        <ul class="active-filters" data-pills-for="doc-list" aria-label="Active filters"></ul>
      </div>

      <div class="dataset" style="--cols: minmax(0, 1fr) 11rem 4.5rem 6.5rem 5.5rem">
        <div class="dataset-head" aria-hidden="true">
          <span>Document</span><span>Kind</span><span>Year</span><span>File</span><span class="num">Open</span>
        </div>
        <ul class="dataset-rows" id="doc-list">
          {rows.map((doc) => (
            <li class="dataset-row" data-item data-kind={doc.kind} data-year={doc.publishedYear ? String(doc.publishedYear) : ''} data-search={doc.search}>
              <div class="cell main">
                <p class="row-title" title={doc.title}>{doc.title}</p>
                <p class="row-sub">
                  {doc.status === 'superseded' ? <span class="chip warn">Superseded</span> : <span>Archived {doc.capturedAt.slice(0, 10)}</span>}
                  {doc.inspected && <span class="chip ok"><Icon name="check" size="12" /> Opened and checked</span>}
                </p>
                <details class="row-more">
                  <summary>Details</summary>
                  <dl>
                    {doc.inspected && <><dt>Opened</dt><dd>{formatDate(doc.inspected.inspectedOn)} ({doc.inspected.pages} {doc.inspected.pages === 1 ? 'page' : 'pages'}): {doc.inspected.summary}</dd></>}
                    <dt>Captured</dt><dd>{formatDate(doc.capturedAt.slice(0, 10))}</dd>
                    <dt>Original address</dt><dd><code>{doc.originalUrl}</code> (dead)</dd>
                  </dl>
                </details>
              </div>
              <span class="cell"><span class="cell-label">Kind</span>{doc.kindLabel}</span>
              <span class="cell"><span class="cell-label">Year</span>{doc.publishedYear ?? '—'}</span>
              <span class="cell muted"><span class="cell-label">File</span>{doc.fileType.toUpperCase()}{doc.size ? ` · ${doc.size}` : ''}</span>
              <span class="cell row-actions">
                {doc.read ? (
                  <>
                    <a class="icon-action primary" href={doc.archiveUrl} rel="noopener noreferrer nofollow" title="Read on this site" {...doc.read}>
                      <Icon name="eye" size="17" /><span class="visually-hidden">Read {doc.title}</span>
                    </a>
                    <a class="icon-action" href={doc.read['data-read']} download={doc.filename} title="Download">
                      <Icon name="download" size="16" /><span class="visually-hidden">Download {doc.title}</span>
                    </a>
                  </>
                ) : (
                  <a class="icon-action" href={doc.archiveUrl} rel="noopener noreferrer nofollow" title="Older Word format: opens in Word or LibreOffice">
                    <Icon name="download" size="16" /><span class="visually-hidden">Get {doc.title} from the Wayback Machine</span>
                  </a>
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="empty-state" data-empty-for="doc-list" hidden>
        <Icon name="search" size="28" />
        <strong>No documents match these filters.</strong>
        <span>Remove a filter above, or reset to see all {formatNumber(rows.length)}.</span>
      </div>
    </section>
  </div>

  <script>
    import '../scripts/filter.ts';
  </script>
</Base>

<style>
  .page-body {
    padding-block: var(--sp-7) var(--sp-9);
  }
  .aside-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-3);
    margin: 0;
  }
  .aside-stats > div {
    padding: var(--sp-4);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }
  .aside-stats dt {
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-band-muted);
  }
  .aside-stats dd {
    margin: var(--sp-1) 0 0;
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--c-band-ink);
  }
  .lead-grid {
    display: grid;
    gap: var(--sp-5);
  }
  @media (min-width: 64rem) {
    .lead-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      align-items: start;
      gap: var(--sp-7);
    }
  }
  .offline {
    margin: 0;
  }
  .section-block {
    margin-top: var(--sp-9);
    scroll-margin-top: calc(var(--header-h) + var(--sp-4));
  }
  .section-block > h2 {
    margin-top: 0;
  }
  .js-block {
    display: none;
  }
  :global(.js) .js-block {
    display: block;
  }
  .kinds {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0 var(--sp-2);
    display: grid;
    gap: var(--sp-2);
    max-width: 52rem;
  }
  .kinds li {
    margin: 0;
  }
  .kind {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) 1fr 3.5rem;
    align-items: center;
    gap: var(--sp-4);
    width: 100%;
    min-height: 44px;
    padding: var(--sp-1) var(--sp-3);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--c-ink);
    text-align: left;
    cursor: pointer;
    transition: background var(--dur-1), border-color var(--dur-1);
  }
  :global(html:not(.js)) .kind {
    cursor: default;
  }
  .kind:hover {
    background: var(--c-bg-alt);
    border-color: var(--c-line);
  }
  .kind[aria-pressed='true'] {
    background: var(--c-accent-wash);
    border-color: var(--c-accent-line);
  }
  .k-label {
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .k-bar {
    height: 12px;
    border-radius: 999px;
    background: var(--c-sunk);
    overflow: hidden;
  }
  .k-bar span {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--c-s4), var(--c-s3));
  }
  .k-count {
    text-align: right;
    font-weight: 800;
    color: var(--c-navy);
  }
  @media (max-width: 30rem) {
    .kind {
      grid-template-columns: 1fr 3rem;
    }
    .k-bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .docs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-3);
  }
  .doc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--sp-3) var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    margin: 0;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    transition: border-color var(--dur-1), box-shadow var(--dur-1);
  }
  .doc:hover {
    border-color: var(--c-accent-line);
    box-shadow: var(--shadow-sm);
  }
  .doc[hidden] {
    display: none;
  }
  @media (min-width: 48rem) {
    .doc {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: start;
    }
  }
  .d-type {
    display: grid;
    place-items: center;
    width: 48px;
    height: 56px;
    border-radius: 6px 14px 6px 6px;
    background: var(--c-clay-wash);
    color: var(--c-clay);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  .doc h3 {
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--c-ink);
    line-height: 1.35;
    margin: 0 0 var(--sp-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-2);
  }
  .file-meta {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .inspected {
    margin: 0 0 var(--sp-2);
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-ok-wash);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    max-width: var(--w-prose);
  }
  .hint {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .hint code {
    overflow-wrap: anywhere;
    font-size: 0.72rem;
  }
  .get {
    display: flex;
    gap: var(--sp-2);
    margin: 0;
    grid-column: 2;
  }
  @media (min-width: 48rem) {
    .get {
      grid-column: auto;
    }
  }
</style>
