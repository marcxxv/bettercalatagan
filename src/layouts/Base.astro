---
import '../styles/tokens.css';
import '../styles/global.css';
import Seo, { type Crumb } from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
}

const { title, description, crumbs, jsonLd, ogType } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#12304a" />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <Seo title={title} description={description} crumbs={crumbs} jsonLd={jsonLd} ogType={ogType} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <style is:global>
      .skip-link {
        position: absolute;
        left: var(--sp-2);
        top: -100px;
        z-index: 20;
        padding: var(--sp-3) var(--sp-4);
        background: var(--c-navy);
        color: var(--c-on-navy);
        font-weight: 700;
        border-radius: var(--radius-sm);
        text-decoration: none;
      }
      .skip-link:focus {
        top: var(--sp-2);
        color: var(--c-on-navy);
      }
      main:focus {
        outline: none;
      }
    </style>
  </body>
</html>
