{
  "name": "bettercalatagan",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Better Calatagan — an independent civic-information portal for the Municipality of Calatagan, Batangas.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . --ext .ts,.mts,.astro",
    "lint:fix": "eslint . --ext .ts,.mts,.astro --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "fdp:stage": "NODE_EXTRA_CA_CERTS=certs/geotrust-tls-rsa-ca-g1.pem node scripts/fdp.mjs stage",
    "fdp:promote": "node scripts/fdp.mjs promote",
    "validate:data": "vitest run src/data"
  },
  "dependencies": {
    "astro": "^5.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^17.12.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.0.9"
  }
}
