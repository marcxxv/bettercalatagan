{
  "name": "bettercalatagan",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Better Calatagan \u2014 an independent civic-information portal for the Municipality of Calatagan, Batangas.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . --ext .ts,.mts,.astro",
    "lint:fix": "eslint . --ext .ts,.mts,.astro --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "fdp:stage": "NODE_EXTRA_CA_CERTS=certs/dilg-intermediates.pem node scripts/fdp.mjs stage",
    "fdp:promote": "node scripts/fdp.mjs promote",
    "validate:data": "vitest run src/data",
    "fdp:extract": "NODE_EXTRA_CA_CERTS=certs/dilg-intermediates.pem node scripts/sre.mjs extract",
    "psa:fetch": "node scripts/psa.mjs fetch",
    "archive:index": "node scripts/documents.mjs build",
    "dpwh:fetch": "node scripts/dpwh.mjs fetch",
    "cmci:fetch": "node scripts/cmci.mjs fetch",
    "poverty:fetch": "node scripts/poverty.mjs fetch",
    "boundaries:fetch": "node scripts/boundaries.mjs fetch",
    "data:refresh": "npm run fdp:stage && npm run fdp:promote && npm run fdp:extract && npm run psa:fetch && npm run archive:index && npm run dpwh:fetch && npm run cmci:fetch && npm run poverty:fetch",
    "data:report": "node scripts/data-report.mjs"
  },
  "dependencies": {
    "astro": "^7.4.4",
    "fflate": "^0.8.3",
    "maplibre-gl": "^6.16.0",
    "pdfjs-dist": "^6.5.438",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^17.14.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1",
    "ultrahtml": "^1.7.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    }
  }
}
